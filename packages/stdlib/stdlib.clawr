subset boolean = truthvalue(false | true)
subset natural = integer(1...)

subset int32 = integer(-2147483648...2147483647)
subset uint32 = integer(0...4294967295)
subset int64 = integer(-9223372036854775808...9223372036854775807)
subset uint64 = integer(0...18446744073709551615)
subset int128 = integer(-170141183460469231731687303715884105728...170141183460469231731687303715884105727)
subset uint128 = integer(0...340282366920938463463374607431768211455)

type binary16 = real(-65504.0...65504.0) sig 11 bin
type binary32 = real(-340282346638528859811704183484516925440.0...340282346638528859811704183484516925440.0) sig 24 bin
type binary64 = real(-.0....0) sig 53 bin

trait HasStringRepresentation {
    func stringRepresentation() -> string
}

/**
 * Enable `==` and `!=` comparisons.
 * Combine with Ordered to enable `<=` and `>=`.
 */
trait Equatable {
    func equals(_ other: Self) -> boolean
}

/**
 * Enable `<` and `>` comparisons. The predicate returns true when the
 * receiver precedes the other value and false otherwise.
 * Combine with Equatable to enable `<=` and `>=`.
 */
trait Ordered {
    func isOrderedBefore(_ other: Self) -> boolean
}

extern func print(_ value: HasStringRepresentation)
