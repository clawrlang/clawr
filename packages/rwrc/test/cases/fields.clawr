
data Inner {
    property: integer(0..<100)
}

data Outer {
    property1: integer(0..<100)
    inner: ref Inner
}

@main {
    const a: ref Outer = { property1: 42, inner: { property: 47 } }
    const b = a // infer ref (SHARED)

    const c = copy(of: a) as cow
    mut d = c // infer cow (ISOLATED)

    b->property1 = 0 // changes a
    d.property1 = 1 // only chsnges d

    print(a->property1)
    print(c.property1)

    const e = c.inner
    b->inner->property = 3

    print(e->property)
}
