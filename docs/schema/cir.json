{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "startBlock": {
      "type": "array",
      "items": { "$ref": "#/definitions/statement" }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "statement": {
      "oneOf": [{ "$ref": "#/definitions/call_func" }]
    },
    "call_func": {
      "type": "object",
      "properties": {
        "type": { "const": "CALL_FUNC" },
        "signature": {
          "type": "object",
          "properties": {
            "baseName": { "type": "string" },
            "parameters": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "label": { "type": "string" },
                  "type": { "type": "string" }
                },
                "required": ["type"],
                "additionalProperties": false
              }
            }
          },
          "required": ["baseName", "parameters"],
          "additionalProperties": false
        },
        "arguments": {
          "type": "array",
          "items": { "$ref": "#/definitions/expression" }
        }
      },
      "required": ["type", "signature", "arguments"],
      "additionalProperties": false
    },
    "expression": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": { "const": "STRING_LITERAL" },
            "value": { "type": "string" }
          },
          "required": ["type", "value"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "INTEGER_LITERAL" },
            "value": { "type": "string", "pattern": "^-?\\d+$" }
          },
          "required": ["type", "value"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "TRUTHVALUE_LITERAL" },
            "value": {
              "oneOf": [
                { "const": "false" },
                { "const": "ambiguous" },
                { "const": "true" }
              ]
            }
          },
          "required": ["type", "value"],
          "additionalProperties": false
        },
        {
          "$ref": "#/definitions/call_func"
        }
      ]
    }
  }
}
