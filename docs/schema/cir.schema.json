{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://example.com/schema/cir",
  "title": "Clawr Module",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "startBlock": {
      "type": "array",
      "items": { "$ref": "#/definitions/statement" }
    },
    "declarations": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/declaration" }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "declaration": {
      "oneOf": [
        {
          "type": "object",
          "title": "Data Declaration",
          "properties": {
            "type": { "const": "DATA_DECL" },
            "name": { "type": "string" },
            "fields": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "type": { "type": "string" }
                },
                "required": ["name", "type"],
                "additionalProperties": false
              }
            }
          },
          "required": ["type", "name", "fields"],
          "additionalProperties": false
        }
      ]
    },
    "statement": {
      "oneOf": [{ "$ref": "#/definitions/call_func" }]
    },
    "call_func": {
      "type": "object",
      "properties": {
        "type": { "const": "CALL_FUNC" },
        "signature": {
          "type": "object",
          "properties": {
            "baseName": { "type": "string" },
            "parameters": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "label": { "type": "string" },
                  "type": { "type": "string" }
                },
                "required": ["type"],
                "additionalProperties": false
              }
            }
          },
          "required": ["baseName", "parameters"],
          "additionalProperties": false
        },
        "arguments": {
          "type": "array",
          "items": { "$ref": "#/definitions/expression" }
        }
      },
      "required": ["type", "signature", "arguments"],
      "additionalProperties": false
    },
    "expression": {
      "oneOf": [
        {
          "type": "object",
          "title": "String Literal",
          "properties": {
            "type": { "const": "STRING_LITERAL" },
            "value": { "type": "string" }
          },
          "required": ["type", "value"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "Integer Literal",
          "properties": {
            "type": { "const": "INTEGER_LITERAL" },
            "value": { "type": "string", "pattern": "^-?\\d+$" }
          },
          "required": ["type", "value"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "Truth Value Literal",
          "properties": {
            "type": { "const": "TRUTHVALUE_LITERAL" },
            "value": {
              "oneOf": [
                { "const": "false" },
                { "const": "ambiguous" },
                { "const": "true" }
              ]
            }
          },
          "required": ["type", "value"],
          "additionalProperties": false
        },
        { "$ref": "#/definitions/data_literal" },
        { "$ref": "#/definitions/field_lookup" },
        { "$ref": "#/definitions/call_func" }
      ]
    },
    "data_literal": {
      "type": "object",
      "properties": {
        "type": { "const": "DATA_LITERAL" },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "value": { "$ref": "#/definitions/expression" }
            },
            "required": ["name", "value"],
            "additionalProperties": false
          }
        }
      },
      "required": ["type", "fields"],
      "additionalProperties": false
    },
    "field_lookup": {
      "type": "object",
      "title": "Field Lookup",
      "properties": {
        "type": { "const": "FIELD_LOOKUP" },
        "object": {
          "$ref": "#/definitions/expression"
        },
        "field": { "type": "string" }
      },
      "required": ["type", "object", "field"],
      "additionalProperties": false
    }
  }
}
