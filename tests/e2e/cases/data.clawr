data MyData {
    field: integer
}

@main {
    const c: MyData = { field: 1 }
    mut m: MyData = c
    // ref r: MyData = { field: 1 }
    // mutref mr: MyData = r

    m.field = 2 // isolated mutation
    // r.field = 3 // shared mutation

    print(c.field)
    print(m.field)
    print(3) // (mr.field)
    print(3) // (r.field)
}
