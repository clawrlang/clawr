{
  "name": "@clawr/vscode",
  "displayName": "Clawr Language Support",
  "description": "Syntax and semantic coloring, diagnostics, and refactorings for the Clawr language.",
  "version": "0.1.0",
  "license": "MIT",
  "publisher": "clawr-community",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./dist/src/extension.js",
  "files": [
    "dist",
    "syntaxes",
    "language-configuration.json"
  ],
  "contributes": {
    "configuration": {
      "title": "Clawr",
      "properties": {
        "clawr.sourceFiles": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Ordered source paths relative to the workspace folder. Empty discovers Clawr files in lexical order."
        }
      }
    },
    "languages": [
      {
        "id": "clawr",
        "aliases": [
          "Clawr"
        ],
        "extensions": [
          ".clawr"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "clawr",
        "scopeName": "source.clawr",
        "path": "./syntaxes/clawr.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "prebuild": "npm run build --workspace=@clawr/cir && npm run build --workspace=@clawr/frontend",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test": "npm run test:unit && npm run test:grammar && npm run test:integration",
    "test:unit": "tsc --noEmit -p tsconfig.json && BUN_JSC_useTailCalls=0 bun test ./tests/unit",
    "test:grammar": "vscode-tmgrammar-snap -s source.clawr -g ./syntaxes/clawr.tmLanguage.json tests/grammar/*.clawr",
    "pretest:integration": "npm run build && tsc -p tests/integration/tsconfig.json",
    "test:integration": "node ./scripts/run-integration-tests.mjs",
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@clawr/frontend": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/vscode": "^1.138.0",
    "@vscode/test-electron": "^3.1.0",
    "typescript": "^7.0.2",
    "vscode-tmgrammar-test": "^0.1.3"
  }
}
