{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "http://clawr.lang/schema/cir/DRAFT-0"
    },
    "startBlock": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Statement"
      }
    },
    "declarations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Declaration"
      }
    }
  },
  "required": ["$schema"],
  "unevaluatedProperties": false,
  "$defs": {
    "Statement": {
      "oneOf": [
        { "$ref": "#/$defs/Assign" },
        { "$ref": "#/$defs/EnsureUnique" },
        { "$ref": "#/$defs/FunctionCallStatement" },
        { "$ref": "#/$defs/Release" },
        { "$ref": "#/$defs/Return" },
        { "$ref": "#/$defs/SelfInitialization" },
        { "$ref": "#/$defs/VariableDeclaration" }
      ]
    },

    "Assign": {
      "type": "object",
      "properties": {
        "kind": {
          "$comment": "Declaration discriminator.",
          "const": "ASSIGN"
        },
        "target": {
          "$comment": "Target to mutate.",
          "$ref": "#/$defs/Storage"
        },
        "value": {
          "$comment": "Value to assign to the target.",
          "$ref": "#/$defs/Expression"
        }
      },
      "required": ["kind", "target", "value"],
      "unevaluatedProperties": false
    },

    "Storage": {
      "oneOf": [
        { "$ref": "#/$defs/PropertyReferenceStorage" },
        { "$ref": "#/$defs/VariableReferenceStorage" }
      ]
    },

    "PropertyReferenceStorage": {
      "type": "object",
      "properties": {
        "kind": {
          "$comment": "Declaration discriminator.",
          "const": "PROPERTY_REF"
        },
        "object": {
          "$comment": "The object that owns the property",
          "$ref": "#/$defs/Expression"
        },
        "property": {
          "$comment": "The name of the property to assign to.",
          "type": "string"
        },
        "type": {
          "$comment": "The type of the property.",
          "$ref": "#/$defs/ValueSet"
        }
      },
      "required": ["kind", "object", "property"],
      "unevaluatedProperties": false
    },

    "VariableReferenceStorage": {
      "type": "object",
      "properties": {
        "kind": {
          "$comment": "Declaration discriminator.",
          "const": "VARIABLE_REF"
        },
        "name": {
          "$comment": "The name of the declared variable.",
          "type": "string"
        },
        "type": {
          "$comment": "The type of the declared variable.",
          "$ref": "#/$defs/ValueSet"
        }
      },
      "required": ["kind", "name"],
      "unevaluatedProperties": false
    },

    "EnsureUnique": {
      "type": "object",
      "properties": {
        "kind": {
          "$comment": "Declaration discriminator.",
          "const": "ENSURE_UNIQUE"
        },
        "object": {
          "$comment": "The variable or field to isolate for mutation.",
          "$ref": "#/$defs/Storage"
        }
      },
      "required": ["kind", "object"],
      "unevaluatedProperties": false
    },

    "Release": {
      "type": "object",
      "properties": {
        "kind": {
          "$comment": "Declaration discriminator.",
          "const": "RELEASE"
        },
        "object": {
          "$comment": "The variable or field that exits scope.",
          "$ref": "#/$defs/Storage"
        }
      },
      "required": ["kind", "object"],
      "unevaluatedProperties": false
    },

    "Return": {
      "type": "object",
      "properties": {
        "kind": {
          "$comment": "Declaration discriminator.",
          "const": "RETURN"
        },
        "value": {
          "$comment": "The value to return to the caller.",
          "$ref": "#/$defs/Expression"
        }
      },
      "required": ["kind"],
      "unevaluatedProperties": false
    },

    "SelfInitialization": {
      "type": "object",
      "properties": {
        "kind": {
          "$comment": "Declaration discriminator.",
          "const": "SELF_INIT"
        },
        "type": {
          "$comment": "The type of the `self` variable.",
          "$ref": "#/$defs/RCTypeSet"
        },
        "properties": {
          "$comment": "Property values for initialization discriminator.",
          "type": "array",
          "items": { "$ref": "#/$defs/PropertyInitializer" }
        }
      },
      "required": ["kind", "type", "properties"],
      "unevaluatedProperties": false
    },

    "VariableDeclaration": {
      "type": "object",
      "properties": {
        "kind": {
          "$comment": "Declaration discriminator.",
          "const": "VARIABLE_DECL"
        },
        "name": {
          "$comment": "The name of the declared variable.",
          "type": "string"
        },
        "namespace": {
          "$comment": "Optional namespace.",
          "type": "string"
        },
        "type": {
          "$comment": "The type of the variable.",
          "$ref": "#/$defs/ValueSet"
        },
        "initialValue": {
          "$comment": "The initial value of the variable.",
          "$ref": "#/$defs/Expression"
        }
      },
      "required": ["kind", "name", "type", "initialValue"],
      "unevaluatedProperties": false
    },

    "FunctionCallStatement": {
      "type": "object",
      "$ref": "#/$defs/FunctionCall",
      "unevaluatedProperties": false
    },

    "FunctionCall": {
      "type": "object",
      "properties": {
        "kind": {
          "$comment": "Declaration discriminator.",
          "const": "CALL"
        },
        "receiver": {
          "$comment": "The object whose method to call.",
          "$ref": "#/$defs/Receiver"
        },
        "name": {
          "$comment": "The name of the function to call.",
          "$ref": "#/$defs/FunctionName"
        },
        "arguments": {
          "$comment": "The arguments to send to the function.",
          "type": "array",
          "items": { "$ref": "#/$defs/Expression" }
        }
      },
      "required": ["kind", "name", "arguments"]
    },

    "Receiver": {
      "type": "object",
      "properties": {
        "object": {
          "$comment": "The object whose method to call.",
          "$ref": "#/$defs/Expression"
        },
        "dispatch": {
          "$comment": "The mode of dispatch to call the method.",
          "enum": ["conformance", "direct", "inherited"]
        }
      },
      "required": ["object", "dispatch"],
      "unevaluatedProperties": false
    },

    "Expression": {
      "oneOf": [
        { "$ref": "#/$defs/BinaryOperation" },
        { "$ref": "#/$defs/FunctionCallExpression" },
        { "$ref": "#/$defs/Literal" },
        { "$ref": "#/$defs/MemoryExpression" },
        { "$ref": "#/$defs/PropertyReference" },
        { "$ref": "#/$defs/VariableReference" }
      ]
    },

    "MemoryExpression": {
      "oneOf": [
        { "$ref": "#/$defs/AsShared" },
        { "$ref": "#/$defs/Box" },
        { "$ref": "#/$defs/Allocation" },
        { "$ref": "#/$defs/Retain" }
      ]
    },

    "BinaryOperation": {
      "oneOf": [
        { "$ref": "#/$defs/Arithmetic" },
        { "$ref": "#/$defs/Equality" },
        { "$ref": "#/$defs/LogicalOperation" },
        { "$ref": "#/$defs/OrderComparison" },
        { "$ref": "#/$defs/RefComparison" }
      ]
    },

    "Literal": {
      "oneOf": [
        { "$ref": "#/$defs/IntegerLiteral" },
        { "$ref": "#/$defs/TruthvalueLiteral" },
        { "$ref": "#/$defs/StringLiteral" }
      ]
    },

    "FunctionCallExpression": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/FunctionCall" },
        {
          "type": "object",
          "properties": {
            "type": {
              "$comment": "The type of the returned value.",
              "$ref": "#/$defs/ValueSet"
            }
          },
          "required": ["type"]
        }
      ],
      "unevaluatedProperties": false
    },

    "Equality": {
      "type": "object",
      "properties": {
        "kind": {
          "$comment": "Declaration discriminator.",
          "enum": ["EQUAL", "NOT_EQUAL"]
        },
        "left": {
          "$comment": "The left operand.",
          "$ref": "#/$defs/Expression"
        },
        "right": {
          "$comment": "The right operand.",
          "$ref": "#/$defs/Expression"
        },
        "type": {
          "$comment": "The type of the expression.",
          "$ref": "#/$defs/TruthvalueSet"
        }
      },
      "required": ["kind", "type", "left", "right"],
      "unevaluatedProperties": false
    },

    "Arithmetic": {
      "type": "object",
      "properties": {
        "kind": {
          "$comment": "Declaration discriminator.",
          "enum": [
            "ADDITION",
            "DIVISION",
            "EXPONENTIAL",
            "MODULUS",
            "MULTIPLICATION",
            "SUBTRACTION"
          ]
        },
        "left": {
          "$comment": "The left operand.",
          "$ref": "#/$defs/Expression"
        },
        "right": {
          "$comment": "The right operand.",
          "$ref": "#/$defs/Expression"
        },
        "type": {
          "$comment": "The type of the expression.",
          "oneOf": [
            { "$ref": "#/$defs/IntegerSet" },
            { "$ref": "#/$defs/RealSet" }
          ]
        }
      },
      "required": ["kind", "left", "right", "type"],
      "unevaluatedProperties": false
    },

    "AsShared": {
      "type": "object",
      "properties": {
        "kind": {
          "$comment": "Declaration discriminator.",
          "const": "AS_SHARED"
        },
        "object": {
          "$comment": "The entity to promote to sharing.",
          "$ref": "#/$defs/FunctionCallExpression"
        },
        "type": {
          "$comment": "The type of the entity.",
          "$ref": "#/$defs/RCTypeSet"
        }
      },
      "required": ["kind", "object", "type"],
      "unevaluatedProperties": false
    },

    "Box": {
      "type": "object",
      "properties": {
        "kind": {
          "$comment": "Declaration discriminator.",
          "const": "BOX"
        },
        "expression": {
          "$comment": "The primitive value to box.",
          "$ref": "#/$defs/Expression"
        },
        "type": {
          "$comment": "The type of the boxed value (with boxed flag set).",
          "$ref": "#/$defs/ValueSet"
        }
      },
      "required": ["kind", "expression", "type"],
      "unevaluatedProperties": false
    },

    "IntegerLiteral": {
      "type": "object",
      "properties": {
        "kind": {
          "$comment": "Declaration discriminator.",
          "const": "INTEGER_LITERAL"
        },
        "type": {
          "$comment": "The type of the literal (specified its exact value).",
          "$ref": "#/$defs/IntegerSingleton"
        }
      },
      "required": ["kind", "type"],
      "unevaluatedProperties": false
    },

    "LogicalOperation": {
      "type": "object",
      "properties": {
        "kind": {
          "$comment": "Declaration discriminator.",
          "enum": ["AND", "OR"]
        },
        "left": {
          "$comment": "The left operand.",
          "$ref": "#/$defs/Expression"
        },
        "right": {
          "$comment": "The right operand.",
          "$ref": "#/$defs/Expression"
        },
        "type": {
          "$comment": "The type of the expression.",
          "$ref": "#/$defs/TruthvalueSet"
        }
      },
      "required": ["kind", "left", "right", "type"],
      "unevaluatedProperties": false
    },

    "Allocation": {
      "type": "object",
      "properties": {
        "kind": {
          "$comment": "Declaration discriminator.",
          "const": "ALLOCATION"
        },
        "isolationLevel": {
          "$comment": "The isolation level (ISOLATED od SHARED) of the allocated entity.",
          "$ref": "#/$defs/IsolationLevel"
        },
        "properties": {
          "$comment": "Property values for initialization.",
          "type": "array",
          "items": { "$ref": "#/$defs/PropertyInitializer" }
        },
        "type": {
          "$comment": "The type of the allocated entity.",
          "$ref": "#/$defs/RCTypeSet"
        }
      },
      "required": ["kind", "isolationLevel", "type"],
      "unevaluatedProperties": false
    },

    "Retain": {
      "type": "object",
      "properties": {
        "kind": {
          "$comment": "Declaration discriminator.",
          "const": "RETAIN"
        },
        "object": {
          "$comment": "The variable or field to retain.",
          "$ref": "#/$defs/Storage"
        },
        "type": {
          "$comment": "The type of the retained entity.",
          "$ref": "#/$defs/RCTypeSet"
        }
      },
      "required": ["kind", "object", "type"],
      "unevaluatedProperties": false
    },

    "OrderComparison": {
      "type": "object",
      "properties": {
        "kind": {
          "$comment": "Declaration discriminator.",
          "enum": [
            "GREATER_THAN",
            "GREATER_THAN_OR_EQUAL",
            "LESS_THAN",
            "LESS_THAN_OR_EQUAL"
          ]
        },
        "left": {
          "$comment": "The left operand.",
          "$ref": "#/$defs/Expression"
        },
        "right": {
          "$comment": "The right operand.",
          "$ref": "#/$defs/Expression"
        },
        "type": {
          "$comment": "The type of the expression.",
          "$ref": "#/$defs/TruthvalueSet"
        }
      },
      "required": ["kind", "left", "right", "type"],
      "unevaluatedProperties": false
    },

    "PropertyReference": {
      "type": "object",
      "properties": {
        "kind": {
          "$comment": "Declaration discriminator.",
          "const": "PROPERTY_REF"
        },
        "object": {
          "$comment": "The object that owns the property",
          "$ref": "#/$defs/Expression"
        },
        "property": {
          "$comment": "The name of the referenced property.",
          "type": "string"
        },
        "type": {
          "$comment": "The type of the referenced property.",
          "$ref": "#/$defs/ValueSet"
        }
      },
      "required": ["kind", "object", "property", "type"],
      "unevaluatedProperties": false
    },

    "RefComparison": {
      "type": "object",
      "properties": {
        "kind": {
          "$comment": "Declaration discriminator.",
          "enum": ["NOT_SAME", "SAME"]
        },
        "left": {
          "$comment": "The left operand.",
          "$ref": "#/$defs/Expression"
        },
        "right": {
          "$comment": "The right operand.",
          "$ref": "#/$defs/Expression"
        },
        "type": {
          "$comment": "The type of the expression.",
          "$ref": "#/$defs/TruthvalueSet"
        }
      },
      "required": ["kind", "left", "right", "type"],
      "unevaluatedProperties": false
    },

    "StringLiteral": {
      "type": "object",
      "properties": {
        "kind": {
          "$comment": "Declaration discriminator.",
          "const": "STRING_LITERAL"
        },
        "type": {
          "$comment": "The type of the expression.",
          "$ref": "#/$defs/StringSingleton"
        }
      },
      "required": ["kind", "type"],
      "unevaluatedProperties": false
    },

    "TruthvalueLiteral": {
      "type": "object",
      "properties": {
        "kind": {
          "$comment": "Declaration discriminator.",
          "const": "TRUTHVALUE_LITERAL"
        },
        "type": {
          "$comment": "The type of the expression.",
          "$ref": "#/$defs/TruthvalueSingleton"
        }
      },
      "required": ["kind", "type"],
      "unevaluatedProperties": false
    },

    "VariableReference": {
      "type": "object",
      "properties": {
        "kind": {
          "$comment": "Declaration discriminator.",
          "const": "VARIABLE_REF"
        },
        "name": {
          "$comment": "The name of the referenced variable.",
          "type": "string"
        },
        "type": {
          "$comment": "The type of the variable.",
          "$ref": "#/$defs/ValueSet"
        }
      },
      "required": ["kind", "name", "type"],
      "unevaluatedProperties": false
    },

    "PropertyInitializer": {
      "type": "object",
      "properties": {
        "name": {
          "$comment": "The name of the property.",
          "type": "string"
        },
        "value": {
          "$comment": "The type of the property.",
          "$ref": "#/$defs/Expression"
        }
      },
      "required": ["name", "value"],
      "unevaluatedProperties": false
    },

    "Void": {
      "type": "object",
      "properties": {
        "universe": {
          "$comment": "Declaration discriminator.",
          "const": "void"
        }
      },
      "required": ["universe"],
      "unevaluatedProperties": false
    },

    "ValueSet": {
      "oneOf": [
        { "$ref": "#/$defs/IntegerSet" },
        { "$ref": "#/$defs/RealSet" },
        { "$ref": "#/$defs/InterfaceSet" },
        { "$ref": "#/$defs/RCTypeSet" },
        { "$ref": "#/$defs/StringSet" },
        { "$ref": "#/$defs/TruthvalueSet" }
      ]
    },

    "IntegerSet": {
      "oneOf": [
        { "$ref": "#/$defs/IntegerRange" },
        { "$ref": "#/$defs/IntegerSingleton" }
      ]
    },

    "IntegerSingleton": {
      "type": "object",
      "properties": {
        "universe": {
          "$comment": "Declaration discriminator.",
          "const": "integer"
        },
        "boxed": {
          "$comment": "Present if the value is boxed.",
          "const": true
        },
        "value": {
          "$comment": "The single value of the set.",
          "type": "string",
          "pattern": "^-?\\d+$"
        }
      },
      "required": ["universe", "value"],
      "unevaluatedProperties": false
    },

    "IntegerRange": {
      "type": "object",
      "properties": {
        "universe": {
          "$comment": "Declaration discriminator.",
          "const": "integer"
        },
        "boxed": {
          "$comment": "Present if the value is boxed.",
          "const": true
        },
        "min": {
          "$comment": "The lower bound of the range (inclusive).",
          "type": "string",
          "pattern": "^-?\\d+$"
        },
        "max": {
          "$comment": "The upper bound of the range (inclusive).",
          "type": "string",
          "pattern": "^-?\\d+$"
        }
      },
      "required": ["universe"],
      "unevaluatedProperties": false
    },

    "RealSet": {
      "oneOf": [
        { "$ref": "#/$defs/RealRange" },
        { "$ref": "#/$defs/RealSingleton" }
      ]
    },

    "RealSingleton": {
      "type": "object",
      "properties": {
        "universe": {
          "$comment": "Declaration discriminator.",
          "const": "real"
        },
        "boxed": {
          "$comment": "Present if the value is boxed.",
          "const": true
        },
        "value": {
          "$comment": "The single value of the set.",
          "type": "string",
          "pattern": "^-?\\d+\\.\\d+$"
        }
      },
      "required": ["universe", "value"],
      "unevaluatedProperties": false
    },

    "RealRange": {
      "type": "object",
      "properties": {
        "universe": {
          "$comment": "Declaration discriminator.",
          "const": "real"
        },
        "boxed": {
          "$comment": "Present if the value is boxed.",
          "const": true
        },
        "min": {
          "$comment": "The lower bound of the range (inclusive).",
          "type": "string",
          "pattern": "^-?\\d+\\.\\d+$"
        },
        "max": {
          "$comment": "The upper bound of the range (inclusive).",
          "type": "string",
          "pattern": "^-?\\d+\\.\\d+$"
        }
      },
      "required": ["universe"],
      "unevaluatedProperties": false
    },

    "InterfaceSet": {
      "type": "object",
      "properties": {
        "universe": {
          "$comment": "Declaration discriminator.",
          "const": "interface"
        },
        "namespace": {
          "$comment": "Optional namespace.",
          "type": "string"
        },
        "name": {
          "$comment": "The name of the interface.",
          "type": "string"
        }
      },
      "required": ["universe", "name"],
      "unevaluatedProperties": false
    },

    "RCTypeSet": {
      "type": "object",
      "properties": {
        "universe": {
          "$comment": "Declaration discriminator.",
          "const": "rc-type"
        },
        "namespace": {
          "$comment": "Optional namespace.",
          "type": "string"
        },
        "name": {
          "$comment": "The name of the type.",
          "type": "string"
        }
      },
      "required": ["universe", "name"],
      "unevaluatedProperties": false
    },

    "StringSet": {
      "oneOf": [
        { "$ref": "#/$defs/UnconstrainedString" },
        { "$ref": "#/$defs/StringSingleton" }
      ]
    },

    "UnconstrainedString": {
      "type": "object",
      "properties": {
        "universe": {
          "$comment": "Declaration discriminator.",
          "const": "string"
        }
      },
      "required": ["universe"],
      "unevaluatedProperties": false
    },

    "StringSingleton": {
      "type": "object",
      "properties": {
        "universe": {
          "$comment": "Declaration discriminator.",
          "const": "string"
        },
        "value": {
          "$comment": "The single value in the set.",
          "type": "string"
        }
      },
      "required": ["universe", "value"],
      "unevaluatedProperties": false
    },

    "TruthvalueSet": {
      "oneOf": [
        { "$ref": "#/$defs/TruthvalueSubset" },
        { "$ref": "#/$defs/TruthvalueSingleton" }
      ]
    },

    "TruthvalueSubset": {
      "type": "object",
      "properties": {
        "universe": {
          "$comment": "Declaration discriminator.",
          "const": "truthvalue"
        },
        "boxed": {
          "$comment": "Present if the value is boxed.",
          "const": true
        },
        "values": {
          "$comment": "The values in the set.",
          "type": "array",
          "items": { "$ref": "#/$defs/Truthvalue" }
        }
      },
      "required": ["universe", "values"],
      "unevaluatedProperties": false
    },

    "TruthvalueSingleton": {
      "type": "object",
      "properties": {
        "universe": {
          "$comment": "Declaration discriminator.",
          "const": "truthvalue"
        },
        "boxed": {
          "$comment": "Present if the value is boxed.",
          "const": true
        },
        "value": {
          "$comment": "The single value in the set.",
          "$ref": "#/$defs/Truthvalue"
        }
      },
      "required": ["universe", "value"],
      "unevaluatedProperties": false
    },

    "Truthvalue": {
      "oneOf": [
        { "const": "ambiguous" },
        { "const": "false" },
        { "const": "true" }
      ]
    },

    "IsolationLevel": {
      "oneOf": [{ "const": "ISOLATED" }, { "const": "SHARED" }]
    },

    "FunctionName": {
      "type": "object",
      "properties": {
        "baseName": {
          "$comment": "The base name of the function.",
          "type": "string"
        },
        "labels": {
          "$comment": "The parameter labels (part of the unique name).",
          "type": "array",
          "items": { "type": "string" }
        },
        "namespace": {
          "$comment": "Optional namespace.",
          "type": "string"
        }
      },
      "required": ["baseName", "labels"],
      "unevaluatedProperties": false
    },

    "CanonicalName": {
      "type": "object",
      "properties": {
        "name": {
          "$comment": "The name of a type.",
          "type": "string"
        },
        "namespace": {
          "$comment": "Optional namespace.",
          "type": "string"
        }
      },
      "required": ["name"],
      "unevaluatedProperties": false
    },

    "Declaration": {
      "oneOf": [
        { "$ref": "#/$defs/RCTypeDeclaration" },
        { "$ref": "#/$defs/InterfaceDeclaration" },
        { "$ref": "#/$defs/VariableDeclaration" },
        { "$ref": "#/$defs/FunctionDeclaration" }
      ]
    },

    "RCTypeDeclaration": {
      "type": "object",
      "properties": {
        "kind": {
          "$comment": "Declaration discriminator.",
          "const": "RC_TYPE_DECL"
        },
        "name": {
          "$comment": "The name of the declared type.",
          "type": "string"
        },
        "namespace": {
          "$comment": "Optional namespace.",
          "type": "string"
        },
        "properties": {
          "$comment": "The stored properties of the declared type.",
          "type": "array",
          "items": { "$ref": "#/$defs/PropertyDeclaration" }
        },
        "conformances": {
          "$comment": "Interfaces the declared type conforms to.",
          "type": "array",
          "items": { "$ref": "#/$defs/Conformance" }
        },
        "base": {
          "$comment": "The supertype of the declared type.",
          "$ref": "#/$defs/CanonicalName"
        },
        "methods": {
          "$comment": "The methods of the declared type.",
          "type": "array",
          "items": { "$ref": "#/$defs/FunctionDeclaration" }
        },
        "initializers": {
          "$comment": "Initializer methods of the declared type.",
          "type": "array",
          "items": { "$ref": "#/$defs/FunctionDeclarationVoid" }
        },
        "dispatchTable": {
          "$comment": "Table for looking up interface conformance implementations.",
          "type": "array",
          "items": { "$ref": "#/$defs/DispatchTableEntry" }
        }
      },
      "required": ["kind", "name", "properties"],
      "unevaluatedProperties": false
    },

    "PropertyDeclaration": {
      "type": "object",
      "properties": {
        "name": {
          "$comment": "The name of the property.",
          "type": "string"
        },
        "type": {
          "$comment": "The type of the property.",
          "$ref": "#/$defs/ValueSet"
        }
      },
      "required": ["name", "type"],
      "unevaluatedProperties": false
    },

    "Conformance": {
      "type": "object",
      "properties": {
        "interface": {
          "$comment": "The interface the type conforms to.",
          "$ref": "#/$defs/CanonicalName"
        },
        "fulfillments": {
          "$comment": "Lookup table for implementations.",
          "type": "array",
          "items": { "$ref": "#/$defs/Fulfillment" }
        }
      },
      "required": ["interface", "fulfillments"],
      "unevaluatedProperties": false
    },

    "Fulfillment": {
      "type": "object",
      "properties": {
        "requirement": {
          "$comment": "The required method name.",
          "$ref": "#/$defs/FunctionName"
        },
        "implementation": {
          "$comment": "The name of the method that fulfils the requirement.",
          "$ref": "#/$defs/FunctionName"
        }
      },
      "required": ["requirement", "implementation"],
      "unevaluatedProperties": false
    },

    "DispatchTableEntry": {
      "type": "object",
      "properties": {
        "slot": {
          "$comment": "The requirement.",
          "$ref": "#/$defs/FunctionSignature"
        },
        "declaredIn": {
          "$comment": "The type that introduces the requirement.",
          "$ref": "#/$defs/CanonicalName"
        },
        "implementation": {
          "$comment": "The type (itself or supertype) that implements the requirement.",
          "$ref": "#/$defs/CanonicalName"
        }
      },
      "required": ["slot", "declaredIn"],
      "unevaluatedProperties": false
    },

    "InterfaceDeclaration": {
      "type": "object",
      "properties": {
        "kind": {
          "$comment": "Declaration discriminator.",
          "const": "INTERFACE_DECL"
        },
        "name": { "type": "string", "$comment": "Type name." },
        "namespace": { "type": "string", "$comment": "Optional namespace." },
        "methods": {
          "type": "array",
          "items": { "$ref": "#/$defs/FunctionSignature" },
          "$comment": "Methods that must exist on conforming types."
        }
      },
      "required": ["kind", "name", "methods"],
      "unevaluatedProperties": false
    },

    "FunctionSignature": {
      "type": "object",
      "$ref": "#/$defs/FunctionSignatureCommon",
      "unevaluatedProperties": false
    },

    "FunctionSignatureCommon": {
      "type": "object",
      "properties": {
        "baseName": { "type": "string", "$comment": "Function base name." },
        "labels": {
          "type": "array",
          "items": { "type": "string" },
          "$comment": "Labels; part of the unique function name."
        },
        "parameters": {
          "type": "array",
          "items": { "$ref": "#/$defs/Parameter" },
          "$comment": "Each parameter has `name` and `type`."
        },
        "returnType": {
          "oneOf": [{ "$ref": "#/$defs/ValueSet" }, { "$ref": "#/$defs/Void" }],
          "$comment": "`{\"universe\":\"void\"}` means no result."
        }
      },
      "required": ["baseName", "labels", "parameters", "returnType"]
    },

    "Parameter": {
      "type": "object",
      "properties": {
        "name": {
          "$comment": "The name of the parameter.",
          "type": "string"
        },
        "type": {
          "$comment": "The type of the parameter.",
          "$ref": "#/$defs/ValueSet"
        }
      },
      "required": ["name", "type"],
      "unevaluatedProperties": false
    },

    "FunctionDeclaration": {
      "oneOf": [
        { "$ref": "#/$defs/FunctionDeclarationNonvoid" },
        { "$ref": "#/$defs/FunctionDeclarationVoid" }
      ]
    },

    "FunctionDeclarationVoid": {
      "allOf": [
        { "$ref": "#/$defs/FunctionDeclCommon" },
        {
          "type": "object",
          "properties": {
            "returnType": { "$ref": "#/$defs/Void" }
          }
        }
      ]
    },

    "FunctionDeclarationNonvoid": {
      "allOf": [
        { "$ref": "#/$defs/FunctionDeclCommon" },
        {
          "type": "object",
          "properties": {
            "returnType": { "$ref": "#/$defs/ValueSet" }
          }
        }
      ]
    },

    "FunctionDeclCommon": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/FunctionSignatureCommon" },
        {
          "type": "object",
          "properties": {
            "kind": {
              "$comment": "Declaration discriminator.",
              "const": "FUNCTION_DECL"
            },
            "body": {
              "type": "array",
              "items": { "$ref": "#/$defs/Statement" },
              "$comment": "Function body."
            },
            "namespace": {
              "type": "string",
              "$comment": "Optional namespace (not for methods)."
            }
          },
          "required": ["kind", "body"]
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
