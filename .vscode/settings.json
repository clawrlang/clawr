{
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "files.associations": { "*.cir": "json" },
  "json.schemas": [
    {
      "url": "http://clawr.lang/schema/cir/DRAFT-0",
      "schema": {
        "type": "object",
        "properties": {
          "$schema": { "const": "http://clawr.lang/schema/cir/DRAFT-0" },
          "startBlock": {
            "type": "array",
            "items": { "$ref": "#/$defs/Statement" }
          },
          "declarations": {
            "type": "array",
            "items": { "$ref": "#/$defs/Declaration" }
          }
        },
        "required": ["$schema"],
        "additionalProperties": false,
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$defs": {
          "ClawrModule": {
            "type": "object",
            "properties": {
              "$schema": { "const": "http://clawr.lang/schema/cir/DRAFT-0" },
              "startBlock": {
                "type": "array",
                "items": { "$ref": "#/$defs/Statement" }
              },
              "declarations": {
                "type": "array",
                "items": { "$ref": "#/$defs/Declaration" }
              }
            },
            "required": ["$schema"],
            "additionalProperties": false
          },
          "Statement": {
            "oneOf": [
              { "$ref": "#/$defs/Assign" },
              { "$ref": "#/$defs/EnsureUnique" },
              { "$ref": "#/$defs/FunctionCall" },
              { "$ref": "#/$defs/Release" },
              { "$ref": "#/$defs/Return" },
              { "$ref": "#/$defs/VariableDeclaration" }
            ]
          },
          "Assign": {
            "type": "object",
            "properties": {
              "kind": { "const": "ASSIGN" },
              "target": { "$ref": "#/$defs/Storage" },
              "value": { "$ref": "#/$defs/Expression" }
            },
            "required": ["kind", "target", "value"],
            "additionalProperties": false
          },
          "Storage": {
            "oneOf": [
              { "$ref": "#/$defs/OmitFieldReferencevalue" },
              { "$ref": "#/$defs/OmitVariableReferencevalue" }
            ]
          },
          "OmitFieldReferencevalue": {
            "type": "object",
            "properties": {
              "kind": { "const": "FIELD_REF" },
              "object": { "$ref": "#/$defs/Expression" },
              "field": { "type": "string" }
            },
            "required": ["kind", "object", "field"],
            "additionalProperties": false
          },
          "Expression": {
            "oneOf": [
              { "$ref": "#/$defs/FunctionCall__type" },
              { "$ref": "#/$defs/AsShared" },
              { "$ref": "#/$defs/FieldReference" },
              { "$ref": "#/$defs/IntegerLiteralbigint" },
              { "$ref": "#/$defs/MemoryAllocation" },
              { "$ref": "#/$defs/MemoryRetention" },
              { "$ref": "#/$defs/StringLiteral" },
              { "$ref": "#/$defs/TruthLiteraltruthvalue" },
              { "$ref": "#/$defs/VariableReference" }
            ]
          },
          "FunctionCall__type": {
            "type": "object",
            "properties": {
              "kind": { "const": "CALL" },
              "receiver": {
                "oneOf": [
                  { "$ref": "#/$defs/__type" },
                  { "$ref": "#/$defs/__type.o3" },
                  { "$ref": "#/$defs/__type.o2" },
                  { "$ref": "#/$defs/__type.o1" }
                ],
                "discriminator": {
                  "mapping": {
                    "conformance-closed": "#/components/schemas/__type.o2",
                    "conformance-open": "#/components/schemas/__type.o3",
                    "direct": "#/components/schemas/__type",
                    "inherited": "#/components/schemas/__type.o1"
                  },
                  "propertyName": "dispatch"
                }
              },
              "name": { "$ref": "#/$defs/FunctionName__type" },
              "arguments": {
                "type": "array",
                "items": { "$ref": "#/$defs/Expression" }
              },
              "value": { "$ref": "#/$defs/Lattice" }
            },
            "required": ["kind", "name", "arguments", "value"],
            "additionalProperties": false
          },
          "__type": {
            "type": "object",
            "properties": {
              "object": { "$ref": "#/$defs/Storage" },
              "dispatch": { "const": "direct" },
              "type": { "$ref": "#/$defs/CanonicalName" }
            },
            "required": ["object", "dispatch", "type"],
            "additionalProperties": false
          },
          "CanonicalName": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "namespace": { "type": "string" }
            },
            "required": ["name"],
            "additionalProperties": false
          },
          "__type.o3": {
            "type": "object",
            "properties": {
              "object": { "$ref": "#/$defs/Storage" },
              "dispatch": { "const": "conformance-open" },
              "declaredIn": { "$ref": "#/$defs/CanonicalName" }
            },
            "required": ["object", "dispatch", "declaredIn"],
            "additionalProperties": false
          },
          "__type.o2": {
            "type": "object",
            "properties": {
              "object": { "$ref": "#/$defs/Storage" },
              "dispatch": { "const": "conformance-closed" },
              "declaredIn": { "$ref": "#/$defs/CanonicalName" }
            },
            "required": ["object", "dispatch", "declaredIn"],
            "additionalProperties": false
          },
          "__type.o1": {
            "type": "object",
            "properties": {
              "object": { "$ref": "#/$defs/Storage" },
              "dispatch": { "const": "inherited" },
              "declaredIn": { "$ref": "#/$defs/CanonicalName" }
            },
            "required": ["object", "dispatch", "declaredIn"],
            "additionalProperties": false
          },
          "FunctionName__type": {
            "type": "object",
            "properties": {
              "baseName": { "type": "string" },
              "labels": { "type": "array", "items": { "type": "string" } },
              "namespace": { "type": "string" }
            },
            "required": ["baseName", "labels"],
            "additionalProperties": false
          },
          "Lattice": {
            "oneOf": [
              { "$ref": "#/$defs/__type__type__type" },
              { "$ref": "#/$defs/__type__type__type.o1" },
              { "$ref": "#/$defs/__type__type__type.o2" },
              { "$ref": "#/$defs/__type__type__type.o3" },
              { "$ref": "#/$defs/RCTypeLattice" },
              { "$ref": "#/$defs/RealLattice" },
              { "$ref": "#/$defs/StringLattice" },
              { "$ref": "#/$defs/TruthvalueLatticetruthvalue" }
            ]
          },
          "__type__type__type": {
            "type": "object",
            "properties": { "type": { "const": "integer" } },
            "required": ["type"],
            "additionalProperties": false
          },
          "__type__type__type.o1": {
            "type": "object",
            "properties": {
              "type": { "const": "integer" },
              "max": { "type": "string", "pattern": "^-?\\d+$" }
            },
            "required": ["type", "max"],
            "additionalProperties": false
          },
          "__type__type__type.o2": {
            "type": "object",
            "properties": {
              "type": { "const": "integer" },
              "min": { "type": "string", "pattern": "^-?\\d+$" }
            },
            "required": ["type", "min"],
            "additionalProperties": false
          },
          "__type__type__type.o3": {
            "type": "object",
            "properties": {
              "type": { "const": "integer" },
              "min": { "type": "string", "pattern": "^-?\\d+$" },
              "max": { "type": "string", "pattern": "^-?\\d+$" }
            },
            "required": ["type", "min", "max"],
            "additionalProperties": false
          },
          "RCTypeLattice": {
            "type": "object",
            "properties": {
              "type": { "const": "rc-type" },
              "namespace": { "type": "string" },
              "name": { "type": "string" }
            },
            "required": ["type", "name"],
            "additionalProperties": false
          },
          "RealLattice": {
            "type": "object",
            "properties": {
              "type": { "const": "real" },
              "min": { "type": "string" },
              "max": { "type": "string" }
            },
            "required": ["type"],
            "additionalProperties": false
          },
          "StringLattice": {
            "type": "object",
            "properties": {
              "type": { "const": "string" },
              "value": { "type": "string" }
            },
            "required": ["type"],
            "additionalProperties": false
          },
          "TruthvalueLatticetruthvalue": {
            "type": "object",
            "properties": {
              "type": { "const": "truthvalue" },
              "values": {
                "type": "array",
                "items": { "$ref": "#/$defs/truthvalue" }
              }
            },
            "required": ["type", "values"],
            "additionalProperties": false
          },
          "truthvalue": {
            "oneOf": [
              { "const": "ambiguous" },
              { "const": "false" },
              { "const": "true" }
            ]
          },
          "AsShared": {
            "type": "object",
            "properties": {
              "kind": { "const": "AS_SHARED" },
              "object": { "$ref": "#/$defs/FunctionCall__type" },
              "value": { "$ref": "#/$defs/RCTypeLattice" }
            },
            "required": ["kind", "object", "value"],
            "additionalProperties": false
          },
          "FieldReference": {
            "type": "object",
            "properties": {
              "kind": { "const": "FIELD_REF" },
              "object": { "$ref": "#/$defs/Expression" },
              "field": { "type": "string" },
              "value": { "$ref": "#/$defs/Lattice" }
            },
            "required": ["kind", "object", "field", "value"],
            "additionalProperties": false
          },
          "IntegerLiteralbigint": {
            "type": "object",
            "properties": {
              "kind": { "const": "INTEGER_LITERAL" },
              "value": { "$ref": "#/$defs/IntegerLatticebigintbigint" }
            },
            "required": ["kind", "value"],
            "additionalProperties": false
          },
          "IntegerLatticebigintbigint": {
            "type": "object",
            "properties": {
              "type": { "const": "integer" },
              "min": { "type": "string", "pattern": "^-?\\d+$" },
              "max": { "type": "string", "pattern": "^-?\\d+$" }
            },
            "required": ["type", "min", "max"],
            "additionalProperties": false
          },
          "MemoryAllocation": {
            "type": "object",
            "properties": {
              "kind": { "const": "ALLOCATION" },
              "base": { "$ref": "#/$defs/CanonicalName" },
              "isolationLevel": { "$ref": "#/$defs/IsolationLevel" },
              "fields": {
                "type": "array",
                "items": { "$ref": "#/$defs/__type.o4" }
              },
              "value": { "$ref": "#/$defs/RCTypeLattice" }
            },
            "required": ["kind", "isolationLevel", "fields", "value"],
            "additionalProperties": false
          },
          "IsolationLevel": {
            "oneOf": [{ "const": "ISOLATED" }, { "const": "SHARED" }]
          },
          "__type.o4": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "value": { "$ref": "#/$defs/Expression" }
            },
            "required": ["name", "value"],
            "additionalProperties": false
          },
          "MemoryRetention": {
            "type": "object",
            "properties": {
              "kind": { "const": "RETAIN" },
              "object": { "$ref": "#/$defs/Storage" },
              "value": { "$ref": "#/$defs/RCTypeLattice" }
            },
            "required": ["kind", "object", "value"],
            "additionalProperties": false
          },
          "StringLiteral": {
            "type": "object",
            "properties": {
              "kind": { "const": "STRING_LITERAL" },
              "value": { "$ref": "#/$defs/StringLattice__type" }
            },
            "required": ["kind", "value"],
            "additionalProperties": false
          },
          "StringLattice__type": {
            "type": "object",
            "properties": {
              "type": { "const": "string" },
              "value": { "type": "string" }
            },
            "required": ["type", "value"],
            "additionalProperties": false
          },
          "TruthLiteraltruthvalue": {
            "type": "object",
            "properties": {
              "kind": { "const": "TRUTHVALUE_LITERAL" },
              "value": { "$ref": "#/$defs/TruthvalueLatticetruthvalue.o1" }
            },
            "required": ["kind", "value"],
            "additionalProperties": false
          },
          "TruthvalueLatticetruthvalue.o1": {
            "type": "object",
            "properties": {
              "type": { "const": "truthvalue" },
              "values": {
                "type": "array",
                "prefixItems": [{ "$ref": "#/$defs/truthvalue" }],
                "additionalItems": false
              }
            },
            "required": ["type", "values"],
            "additionalProperties": false
          },
          "VariableReference": {
            "type": "object",
            "properties": {
              "kind": { "const": "VARIABLE_REF" },
              "name": { "type": "string" },
              "value": { "$ref": "#/$defs/Lattice" }
            },
            "required": ["kind", "name", "value"],
            "additionalProperties": false
          },
          "OmitVariableReferencevalue": {
            "type": "object",
            "properties": {
              "kind": { "const": "VARIABLE_REF" },
              "name": { "type": "string" }
            },
            "required": ["kind", "name"],
            "additionalProperties": false
          },
          "EnsureUnique": {
            "type": "object",
            "properties": {
              "kind": { "const": "ENSURE_UNIQUE" },
              "object": { "$ref": "#/$defs/Storage" }
            },
            "required": ["kind", "object"],
            "additionalProperties": false
          },
          "FunctionCall": {
            "type": "object",
            "properties": {
              "kind": { "const": "CALL" },
              "receiver": {
                "oneOf": [
                  { "$ref": "#/$defs/__type" },
                  { "$ref": "#/$defs/__type.o3" },
                  { "$ref": "#/$defs/__type.o2" },
                  { "$ref": "#/$defs/__type.o1" }
                ],
                "discriminator": {
                  "mapping": {
                    "conformance-closed": "#/components/schemas/__type.o2",
                    "conformance-open": "#/components/schemas/__type.o3",
                    "direct": "#/components/schemas/__type",
                    "inherited": "#/components/schemas/__type.o1"
                  },
                  "propertyName": "dispatch"
                }
              },
              "name": { "$ref": "#/$defs/FunctionName__type" },
              "arguments": {
                "type": "array",
                "items": { "$ref": "#/$defs/Expression" }
              }
            },
            "required": ["kind", "name", "arguments"],
            "additionalProperties": false
          },
          "Release": {
            "type": "object",
            "properties": {
              "kind": { "const": "RELEASE" },
              "object": { "$ref": "#/$defs/Storage" }
            },
            "required": ["kind", "object"],
            "additionalProperties": false
          },
          "Return": {
            "type": "object",
            "properties": {
              "kind": { "const": "RETURN" },
              "value": {
                "oneOf": [
                  { "$ref": "#/$defs/FunctionCall__type" },
                  { "$ref": "#/$defs/AsShared" },
                  { "$ref": "#/$defs/FieldReference" },
                  { "$ref": "#/$defs/IntegerLiteralbigint" },
                  { "$ref": "#/$defs/MemoryAllocation" },
                  { "$ref": "#/$defs/MemoryRetention" },
                  { "$ref": "#/$defs/StringLiteral" },
                  { "$ref": "#/$defs/TruthLiteraltruthvalue" },
                  { "$ref": "#/$defs/VariableReference" }
                ]
              }
            },
            "required": ["kind"],
            "additionalProperties": false
          },
          "VariableDeclaration": {
            "type": "object",
            "properties": {
              "kind": { "const": "VARIABLE_DECL" },
              "name": { "type": "string" },
              "lattice": { "$ref": "#/$defs/Lattice" },
              "initialValue": { "$ref": "#/$defs/Expression" }
            },
            "required": ["kind", "name", "lattice", "initialValue"],
            "additionalProperties": false
          },
          "Declaration": {
            "oneOf": [
              { "$ref": "#/$defs/__typeProtocolDeclaration" },
              { "$ref": "#/$defs/__typeVariableDeclaration" },
              { "$ref": "#/$defs/__type__type" },
              { "$ref": "#/$defs/__type__typeFunctionSignature" },
              { "$ref": "#/$defs/__type__type__type.o4" }
            ]
          },
          "__typeProtocolDeclaration": {
            "type": "object",
            "properties": {
              "kind": { "const": "PROTOCOL_DECL" },
              "name": { "type": "string" },
              "slots": {
                "type": "array",
                "items": { "$ref": "#/$defs/FunctionSignature" }
              },
              "namespace": { "type": "string" }
            },
            "required": ["kind", "name", "slots"],
            "additionalProperties": false
          },
          "FunctionSignature": {
            "type": "object",
            "properties": {
              "baseName": { "type": "string" },
              "labels": { "type": "array", "items": { "type": "string" } },
              "parameters": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string" },
                    "lattice": { "$ref": "#/$defs/Lattice" }
                  },
                  "required": ["name", "lattice"],
                  "additionalProperties": false
                }
              },
              "lattice": {
                "oneOf": [
                  { "$ref": "#/$defs/__type__type__type.o3" },
                  { "$ref": "#/$defs/__type__type__type.o2" },
                  { "$ref": "#/$defs/__type__type__type.o1" },
                  { "$ref": "#/$defs/__type__type__type" },
                  { "$ref": "#/$defs/RCTypeLattice" },
                  { "$ref": "#/$defs/RealLattice" },
                  { "$ref": "#/$defs/StringLattice" },
                  { "$ref": "#/$defs/TruthvalueLatticetruthvalue" }
                ]
              }
            },
            "required": ["baseName", "labels", "parameters"],
            "additionalProperties": false
          },
          "__typeVariableDeclaration": {
            "type": "object",
            "properties": {
              "kind": { "const": "VARIABLE_DECL" },
              "name": { "type": "string" },
              "lattice": { "$ref": "#/$defs/Lattice" },
              "initialValue": { "$ref": "#/$defs/Expression" },
              "namespace": { "type": "string" }
            },
            "required": ["kind", "name", "lattice", "initialValue"],
            "additionalProperties": false
          },
          "__type__type": {
            "type": "object",
            "properties": {
              "namespace": { "type": "string" },
              "kind": { "const": "RC_TYPE_DECL" },
              "name": { "type": "string" },
              "fields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string" },
                    "lattice": { "$ref": "#/$defs/Lattice" }
                  },
                  "required": ["name", "lattice"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["kind", "name", "fields"],
            "additionalProperties": false
          },
          "__type__typeFunctionSignature": {
            "type": "object",
            "properties": {
              "kind": { "const": "FUNCTION_DECL" },
              "body": {
                "type": "array",
                "items": { "$ref": "#/$defs/Statement" }
              },
              "baseName": { "type": "string" },
              "labels": { "type": "array", "items": { "type": "string" } },
              "parameters": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string" },
                    "lattice": { "$ref": "#/$defs/Lattice" }
                  },
                  "required": ["name", "lattice"],
                  "additionalProperties": false
                }
              },
              "lattice": {
                "oneOf": [
                  { "$ref": "#/$defs/__type__type__type.o3" },
                  { "$ref": "#/$defs/__type__type__type.o2" },
                  { "$ref": "#/$defs/__type__type__type.o1" },
                  { "$ref": "#/$defs/__type__type__type" },
                  { "$ref": "#/$defs/RCTypeLattice" },
                  { "$ref": "#/$defs/RealLattice" },
                  { "$ref": "#/$defs/StringLattice" },
                  { "$ref": "#/$defs/TruthvalueLatticetruthvalue" }
                ]
              },
              "namespace": { "type": "string" }
            },
            "required": ["kind", "body", "baseName", "labels", "parameters"],
            "additionalProperties": false
          },
          "__type__type__type.o4": {
            "type": "object",
            "properties": {
              "namespace": { "type": "string" },
              "kind": { "const": "RC_TYPE_DECL" },
              "name": { "type": "string" },
              "fields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string" },
                    "lattice": { "$ref": "#/$defs/Lattice" }
                  },
                  "required": ["name", "lattice"],
                  "additionalProperties": false
                }
              },
              "base": { "$ref": "#/$defs/CanonicalName" },
              "methods": {
                "type": "array",
                "items": { "$ref": "#/$defs/FunctionDeclaration" }
              },
              "implements": {
                "type": "array",
                "items": { "$ref": "#/$defs/ProtocolImplementation" }
              },
              "initializers": {
                "type": "array",
                "items": { "$ref": "#/$defs/__typeFunctionSignature__type" }
              },
              "dispatchTable": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "slot": { "$ref": "#/$defs/FunctionSignature" },
                    "declaredIn": { "$ref": "#/$defs/CanonicalName" },
                    "implementedBy": { "$ref": "#/$defs/CanonicalName" }
                  },
                  "required": ["slot", "declaredIn"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["kind", "name", "fields", "methods"],
            "additionalProperties": false
          },
          "FunctionDeclaration": {
            "type": "object",
            "properties": {
              "kind": { "const": "FUNCTION_DECL" },
              "body": {
                "type": "array",
                "items": { "$ref": "#/$defs/Statement" }
              },
              "baseName": { "type": "string" },
              "labels": { "type": "array", "items": { "type": "string" } },
              "parameters": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string" },
                    "lattice": { "$ref": "#/$defs/Lattice" }
                  },
                  "required": ["name", "lattice"],
                  "additionalProperties": false
                }
              },
              "lattice": {
                "oneOf": [
                  { "$ref": "#/$defs/__type__type__type.o3" },
                  { "$ref": "#/$defs/__type__type__type.o2" },
                  { "$ref": "#/$defs/__type__type__type.o1" },
                  { "$ref": "#/$defs/__type__type__type" },
                  { "$ref": "#/$defs/RCTypeLattice" },
                  { "$ref": "#/$defs/RealLattice" },
                  { "$ref": "#/$defs/StringLattice" },
                  { "$ref": "#/$defs/TruthvalueLatticetruthvalue" }
                ]
              }
            },
            "required": ["kind", "body", "baseName", "labels", "parameters"],
            "additionalProperties": false
          },
          "ProtocolImplementation": {
            "type": "object",
            "properties": {
              "protocol": { "type": "string" },
              "methodMap": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "interfaceMethod": { "$ref": "#/$defs/FunctionName" },
                    "implementationMethod": { "$ref": "#/$defs/FunctionName" }
                  },
                  "required": ["interfaceMethod", "implementationMethod"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["protocol", "methodMap"],
            "additionalProperties": false
          },
          "FunctionName": {
            "type": "object",
            "properties": {
              "baseName": { "type": "string" },
              "labels": { "type": "array", "items": { "type": "string" } }
            },
            "required": ["baseName", "labels"],
            "additionalProperties": false
          },
          "__typeFunctionSignature__type": {
            "type": "object",
            "properties": {
              "kind": { "const": "FUNCTION_DECL" },
              "body": {
                "type": "array",
                "items": { "$ref": "#/$defs/Statement" }
              },
              "baseName": { "type": "string" },
