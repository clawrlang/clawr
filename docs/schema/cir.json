{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$main": {
      "type": "array",
      "items": { "$ref": "#/definitions/statement" }
    },
    "additionalProperties": false
  },
  "definitions": {
    "statement": {
      "oneOf": [{ "$ref": "#/definitions/call_func" }]
    },
    "call_func": {
      "type": "object",
      "properties": {
        "type": { "const": "CALL_FUNC" },
        "signature": {
          "type": "object",
          "properties": {
            "baseName": { "type": "string" },
            "parameters": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "label": { "type": "string" },
                  "type": { "type": "string" },
                  "argument": { "$ref": "#/definitions/expression" }
                },
                "required": ["type", "argument"],
                "additionalProperties": false
              }
            }
          },
          "required": ["baseName", "parameters"],
          "additionalProperties": false
        }
      },
      "required": ["type", "signature"],
      "additionalProperties": false
    },
    "expression": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": { "const": "STRING_LITERAL" },
            "value": { "type": "string" }
          },
          "required": ["type", "value"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "INTEGER_LITERAL" },
            "value": { "type": "string", "pattern": "^\\d+$" }
          },
          "required": ["type", "value"],
          "additionalProperties": false
        }
      ]
    }
  }
}
