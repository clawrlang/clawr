
data EmptyData {}
data MyData {
    mut property1: integer(0..<100)
    mut property2: ref EmptyData
}

const a: ref MyData = { property1: 42, property2: {} }
const b = copy(of: a)

func getShared() -> ref MyData => a
func getIsolated() -> const MyData => b
// func getUnique() -> MyData => b // not possible/allowed?

func modify(_ x: ref MyData) {
    x->property1 = 10
}
func read(_ x: MyData) {

}
func with(_ x: MyData) {} // either

@main {

    const c = a->property1 // incorrectly retained
    const d = b.property1 // incorrectly retained

    const e = a->property2
    const f = b.property2

    const g = copy(of: getIsolated())
    const h = getIsolated()

    with(a)
    with(b)
    with(getShared())
    with(getIsolated())
    modify(a)
    modify(copy(of: b)) // still suspicious
    modify(getShared())
    modify(getIsolated()) // not allowed - semantic mismatch

    read(copy(of: a))
    read(b)
    read(copy(of: getShared()))
    read(getIsolated())
}
