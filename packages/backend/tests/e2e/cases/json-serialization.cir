# yaml-language-server: $schema=../../../../../schema/cir.schema.json
$schema: http://clawr.lang/schema/cir/DRAFT-0
declarations:
  - kind: RC_TYPE_DECL
    name: Leaf
    properties:
      - name: value
        type:
          universe: integer
    conformances:
      - interface:
          name: JSONSerializable
          namespace: clawr
        fulfillments:
          - requirement:
              baseName: toJSON
              labels: []
            implementation:
              baseName: toJSON
              labels: []
  - kind: RC_TYPE_DECL
    name: Record
    properties:
      - name: leaf
        type:
          universe: rc-type
          name: Leaf
      - name: small
        type:
          universe: integer
          min: '0'
          max: '10'
      - name: text
        type:
          universe: string
      - name: binary
        type:
          universe: real
          min: '-340282346638528859811704183484516925440.0'
          max: '340282346638528859811704183484516925440.0'
          precision: { kind: sig, digits: 24, base: bin }
      - name: trit
        type:
          universe: real
          precision: { kind: scale, digits: 1, base: ter }
      - name: state
        type:
          universe: truthvalue
    conformances:
      - interface:
          name: JSONSerializable
          namespace: clawr
        fulfillments:
          - requirement:
              baseName: toJSON
              labels: []
            implementation:
              baseName: toJSON
              labels: []
  - kind: RC_TYPE_DECL
    name: Manual
    properties: []
    methods:
      - kind: FUNCTION_DECL
        baseName: toJSON
        labels: []
        parameters: []
        returnType:
          universe: string
        body:
          - kind: RETURN
            value:
              kind: STRING_LITERAL
              type:
                universe: string
                value: '42'
    initializers: []
    conformances:
      - interface:
          name: JSONSerializable
          namespace: clawr
        fulfillments:
          - requirement:
              baseName: toJSON
              labels: []
            implementation:
              baseName: toJSON
              labels: []
  - kind: VARIABLE_DECL
    name: value
    type:
      universe: rc-type
      name: Record
    initialValue:
      kind: ALLOCATION
      type:
        universe: rc-type
        name: Record
      isolationLevel: ISOLATED
      properties:
        - name: leaf
          value:
            kind: ALLOCATION
            type:
              universe: rc-type
              name: Leaf
            isolationLevel: ISOLATED
            properties:
              - name: value
                value:
                  kind: INTEGER_LITERAL
                  type:
                    universe: integer
                    value: '9007199254740993'
        - name: small
          value:
            kind: INTEGER_LITERAL
            type:
              universe: integer
              value: '7'
        - name: text
          value:
            kind: STRING_LITERAL
            type:
              universe: string
              value: 'hello'
        - name: binary
          value:
            kind: REAL_LITERAL
            type:
              universe: real
              value: '1.25'
              precision: { kind: sig, digits: 24, base: bin }
        - name: trit
          value:
            kind: REAL_LITERAL
            type:
              universe: real
              value: '0.333'
              precision: { kind: scale, digits: 1, base: ter }
        - name: state
          value:
            kind: TRUTHVALUE_LITERAL
            type:
              universe: truthvalue
              value: ambiguous
  - kind: VARIABLE_DECL
    name: manual
    type:
      universe: rc-type
      name: Manual
    initialValue:
      kind: ALLOCATION
      type:
        universe: rc-type
        name: Manual
      isolationLevel: ISOLATED
      properties: []
startBlock:
  - kind: CALL
    name:
      baseName: print
      labels: []
    arguments:
      - kind: CALL
        name:
          baseName: serializeJSON
          labels: []
        arguments:
          - kind: VARIABLE_REF
            name: value
            type:
              universe: rc-type
              name: Record
        type:
          universe: string
  - kind: RELEASE
    object:
      kind: VARIABLE_REF
      name: value
  - kind: CALL
    name:
      baseName: print
      labels: []
    arguments:
      - kind: CALL
        name:
          baseName: serializeJSON
          labels: []
        arguments:
          - kind: VARIABLE_REF
            name: manual
            type:
              universe: rc-type
              name: Manual
        type:
          universe: string
  - kind: RELEASE
    object:
      kind: VARIABLE_REF
      name: manual
