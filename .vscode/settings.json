{
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "files.associations": { "*.cir": "json" },
  "json.schemas": [
    {
      "url": "http://clawr.lang/schema/cir/DRAFT-0",
      "schema": {
        "type": "object",
        "properties": {
          "$schema": { "const": "http://clawr.lang/schema/cir/DRAFT-0" },
          "startBlock": {
            "type": "array",
            "items": { "$ref": "#/$defs/Statement" }
          },
          "declarations": {
            "type": "array",
            "items": { "$ref": "#/$defs/Declaration" }
          }
        },
        "required": ["$schema"],
        "additionalProperties": false,
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$defs": {
          "ClawrModule": {
            "type": "object",
            "properties": {
              "$schema": { "const": "http://clawr.lang/schema/cir/DRAFT-0" },
              "startBlock": {
                "type": "array",
                "items": { "$ref": "#/$defs/Statement" }
              },
              "declarations": {
                "type": "array",
                "items": { "$ref": "#/$defs/Declaration" }
              }
            },
            "required": ["$schema"],
            "additionalProperties": false
          },
          "Statement": {
            "oneOf": [
              { "$ref": "#/$defs/Assign" },
              { "$ref": "#/$defs/EnsureUnique" },
              { "$ref": "#/$defs/Exec" },
              { "$ref": "#/$defs/Release" },
              { "$ref": "#/$defs/Return" },
              { "$ref": "#/$defs/VariableDeclaration" }
            ]
          },
          "Assign": {
            "type": "object",
            "properties": {
              "kind": { "const": "ASSIGN" },
              "target": { "$ref": "#/$defs/Storage" },
              "value": { "$ref": "#/$defs/Expression" }
            },
            "required": ["kind", "target", "value"],
            "additionalProperties": false
          },
          "Storage": {
            "oneOf": [
              { "$ref": "#/$defs/FieldReference" },
              { "$ref": "#/$defs/VariableReference" }
            ]
          },
          "FieldReference": {
            "type": "object",
            "properties": {
              "kind": { "const": "FIELD_REF" },
              "object": { "$ref": "#/$defs/Expression" },
              "field": { "type": "string" },
              "valueSet": { "$ref": "#/$defs/ValueSet" }
            },
            "required": ["kind", "object", "field", "valueSet"],
            "additionalProperties": false
          },
          "Expression": {
            "oneOf": [
              { "$ref": "#/$defs/AsShared" },
              { "$ref": "#/$defs/FieldReference" },
              { "$ref": "#/$defs/IntegerLiteral" },
              { "$ref": "#/$defs/MemoryAllocation" },
              { "$ref": "#/$defs/MemoryRetention" },
              { "$ref": "#/$defs/QueryFunctionCall" },
              { "$ref": "#/$defs/StringLiteral" },
              { "$ref": "#/$defs/TruthLiteral" },
              { "$ref": "#/$defs/VariableReference" }
            ]
          },
          "AsShared": {
            "type": "object",
            "properties": {
              "kind": { "const": "AS_SHARED" },
              "object": { "$ref": "#/$defs/QueryFunctionCall" },
              "targetSemantics": {
                "oneOf": [{ "const": "COW" }, { "const": "REF" }]
              },
              "valueSet": { "$ref": "#/$defs/RcTypeValueSet" }
            },
            "required": ["kind", "object", "targetSemantics", "valueSet"],
            "additionalProperties": false
          },
          "QueryFunctionCall": {
            "type": "object",
            "properties": {
              "kind": { "const": "QUERY" },
              "name": {
                "type": "object",
                "properties": {
                  "baseName": { "type": "string" },
                  "labels": { "type": "array", "items": { "type": "string" } }
                },
                "required": ["baseName", "labels"],
                "additionalProperties": false
              },
              "arguments": {
                "type": "array",
                "items": { "$ref": "#/$defs/Expression" }
              },
              "valueSet": { "$ref": "#/$defs/ValueSet" }
            },
            "required": ["kind", "name", "arguments", "valueSet"],
            "additionalProperties": false
          },
          "ValueSet": {
            "oneOf": [
              { "$ref": "#/$defs/IntegerValueSet" },
              { "$ref": "#/$defs/RcTypeValueSet" },
              { "$ref": "#/$defs/RealValueSet" },
              { "$ref": "#/$defs/StringValueSet" },
              { "$ref": "#/$defs/TruthValueSet" }
            ]
          },
          "IntegerValueSet": {
            "type": "object",
            "properties": {
              "type": { "const": "integer" },
              "min": { "type": "string" },
              "max": { "type": "string" }
            },
            "required": ["type"],
            "additionalProperties": false
          },
          "RcTypeValueSet": {
            "type": "object",
            "properties": {
              "type": { "const": "rc-type" },
              "typeName": { "type": "string" },
              "semantics": { "oneOf": [{ "const": "COW" }, { "const": "REF" }] }
            },
            "required": ["type", "typeName", "semantics"],
            "additionalProperties": false
          },
          "RealValueSet": {
            "type": "object",
            "properties": {
              "type": { "const": "real" },
              "min": { "type": "string" },
              "max": { "type": "string" }
            },
            "required": ["type"],
            "additionalProperties": false
          },
          "StringValueSet": {
            "type": "object",
            "properties": { "type": { "const": "string" } },
            "required": ["type"],
            "additionalProperties": false
          },
          "TruthValueSet": {
            "type": "object",
            "properties": {
              "type": { "const": "truthvalue" },
              "values": {
                "type": "array",
                "items": {
                  "oneOf": [
                    { "const": "ambiguous" },
                    { "const": "false" },
                    { "const": "true" }
                  ]
                }
              }
            },
            "required": ["type", "values"],
            "additionalProperties": false
          },
          "IntegerLiteral": {
            "type": "object",
            "properties": {
              "kind": { "const": "INTEGER_LITERAL" },
              "value": { "type": "string" },
              "valueSet": { "$ref": "#/$defs/IntegerValueSet" }
            },
            "required": ["kind", "value", "valueSet"],
            "additionalProperties": false
          },
          "MemoryAllocation": {
            "type": "object",
            "properties": {
              "kind": { "const": "ALLOCATE" },
              "valueSet": { "$ref": "#/$defs/RcTypeValueSet" },
              "fields": {
                "type": "array",
                "items": { "$ref": "#/$defs/__type.o1" }
              }
            },
            "required": ["kind", "valueSet", "fields"],
            "additionalProperties": false
          },
          "__type.o1": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "value": { "$ref": "#/$defs/Expression" }
            },
            "required": ["name", "value"],
            "additionalProperties": false
          },
          "MemoryRetention": {
            "type": "object",
            "properties": {
              "kind": { "const": "RETAIN" },
              "object": { "$ref": "#/$defs/Storage" },
              "valueSet": { "$ref": "#/$defs/RcTypeValueSet" }
            },
            "required": ["kind", "object", "valueSet"],
            "additionalProperties": false
          },
          "StringLiteral": {
            "type": "object",
            "properties": {
              "kind": { "const": "STRING_LITERAL" },
              "value": { "type": "string" },
              "valueSet": { "$ref": "#/$defs/StringValueSet" }
            },
            "required": ["kind", "value", "valueSet"],
            "additionalProperties": false
          },
          "TruthLiteral": {
            "type": "object",
            "properties": {
              "kind": { "const": "TRUTHVALUE_LITERAL" },
              "value": {
                "oneOf": [
                  { "const": "ambiguous" },
                  { "const": "false" },
                  { "const": "true" }
                ]
              },
              "valueSet": { "$ref": "#/$defs/TruthValueSet" }
            },
            "required": ["kind", "value", "valueSet"],
            "additionalProperties": false
          },
          "VariableReference": {
            "type": "object",
            "properties": {
              "kind": { "const": "VARIABLE_REF" },
              "name": { "type": "string" },
              "valueSet": { "$ref": "#/$defs/ValueSet" }
            },
            "required": ["kind", "name", "valueSet"],
            "additionalProperties": false
          },
          "EnsureUnique": {
            "type": "object",
            "properties": {
              "kind": { "const": "ENSURE_UNIQUE" },
              "object": { "$ref": "#/$defs/Storage" }
            },
            "required": ["kind", "object"],
            "additionalProperties": false
          },
          "Exec": {
            "type": "object",
            "properties": {
              "kind": { "const": "EXEC" },
              "name": {
                "type": "object",
                "properties": {
                  "baseName": { "type": "string" },
                  "labels": { "type": "array", "items": { "type": "string" } }
                },
                "required": ["baseName", "labels"],
                "additionalProperties": false
              },
              "arguments": {
                "type": "array",
                "items": { "$ref": "#/$defs/Expression" }
              }
            },
            "required": ["kind", "name", "arguments"],
            "additionalProperties": false
          },
          "Release": {
            "type": "object",
            "properties": {
              "kind": { "const": "RELEASE" },
              "object": { "$ref": "#/$defs/Storage" }
            },
            "required": ["kind", "object"],
            "additionalProperties": false
          },
          "Return": {
            "type": "object",
            "properties": {
              "kind": { "const": "RETURN" },
              "value": {
                "oneOf": [
                  { "$ref": "#/$defs/AsShared" },
                  { "$ref": "#/$defs/FieldReference" },
                  { "$ref": "#/$defs/IntegerLiteral" },
                  { "$ref": "#/$defs/MemoryAllocation" },
                  { "$ref": "#/$defs/MemoryRetention" },
                  { "$ref": "#/$defs/QueryFunctionCall" },
                  { "$ref": "#/$defs/StringLiteral" },
                  { "$ref": "#/$defs/TruthLiteral" },
                  { "$ref": "#/$defs/VariableReference" }
                ]
              }
            },
            "required": ["kind"],
            "additionalProperties": false
          },
          "VariableDeclaration": {
            "type": "object",
            "properties": {
              "kind": { "const": "VARIABLE_DECL" },
              "name": { "type": "string" },
              "valueSet": { "$ref": "#/$defs/ValueSet" },
              "initialValue": { "$ref": "#/$defs/Expression" }
            },
            "required": ["kind", "name", "valueSet", "initialValue"],
            "additionalProperties": false
          },
          "Declaration": {
            "oneOf": [
              { "$ref": "#/$defs/DataDeclaration" },
              { "$ref": "#/$defs/FunctionDeclaration" },
              { "$ref": "#/$defs/VariableDeclaration" }
            ]
          },
          "DataDeclaration": {
            "type": "object",
            "properties": {
              "kind": { "const": "DATA_DECL" },
              "name": { "type": "string" },
              "fields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string" },
                    "valueSet": { "$ref": "#/$defs/ValueSet" }
                  },
                  "required": ["name", "valueSet"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["kind", "name", "fields"],
            "additionalProperties": false
          },
          "FunctionDeclaration": {
            "type": "object",
            "properties": {
              "kind": { "const": "FUNCTION_DECL" },
              "baseName": { "type": "string" },
              "parameters": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "label": { "type": "string" },
                    "varName": { "type": "string" },
                    "valueSet": { "$ref": "#/$defs/ValueSet" }
                  },
                  "required": ["varName", "valueSet"],
                  "additionalProperties": false
                }
              },
              "body": {
                "type": "array",
                "items": { "$ref": "#/$defs/Statement" }
              },
              "returnValueSet": {
                "oneOf": [
                  { "$ref": "#/$defs/IntegerValueSet" },
                  { "$ref": "#/$defs/RcTypeValueSet" },
                  { "$ref": "#/$defs/RealValueSet" },
                  { "$ref": "#/$defs/StringValueSet" },
                  { "$ref": "#/$defs/TruthValueSet" }
                ]
              }
            },
            "required": ["kind", "baseName", "parameters", "body"],
            "additionalProperties": false
          }
        }
      }
    }
  ],
  "C_Cpp.default.includePath": ["src/runtime/include"]
}
