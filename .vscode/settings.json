{
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "files.associations": { "*.cir": "json" },
  "json.schemas": [
    {
      "url": "http://clawr.lang/schema/cir/DRAFT-0",
      "schema": {
        "type": "object",
        "properties": {
          "$schema": { "const": "http://clawr.lang/schema/cir/DRAFT-0" },
          "startBlock": {
            "type": "array",
            "items": { "$ref": "#/$defs/Statement" }
          },
          "declarations": {
            "type": "array",
            "items": { "$ref": "#/$defs/Declaration" }
          }
        },
        "required": ["$schema"],
        "additionalProperties": false,
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$defs": {
          "ClawrModule": {
            "type": "object",
            "properties": {
              "$schema": { "const": "http://clawr.lang/schema/cir/DRAFT-0" },
              "startBlock": {
                "type": "array",
                "items": { "$ref": "#/$defs/Statement" }
              },
              "declarations": {
                "type": "array",
                "items": { "$ref": "#/$defs/Declaration" }
              }
            },
            "required": ["$schema"],
            "additionalProperties": false
          },
          "Statement": {
            "oneOf": [
              { "$ref": "#/$defs/Assign" },
              { "$ref": "#/$defs/EnsureUnique" },
              { "$ref": "#/$defs/FunctionCall" },
              { "$ref": "#/$defs/Release" },
              { "$ref": "#/$defs/Return" },
              { "$ref": "#/$defs/VariableDeclaration" }
            ]
          },
          "Assign": {
            "type": "object",
            "properties": {
              "kind": { "const": "ASSIGN" },
              "target": { "$ref": "#/$defs/Storage" },
              "value": { "$ref": "#/$defs/Expression" }
            },
            "required": ["kind", "target", "value"],
            "additionalProperties": false
          },
          "Storage": {
            "oneOf": [
              { "$ref": "#/$defs/FieldReference" },
              { "$ref": "#/$defs/VariableReference" }
            ]
          },
          "FieldReference": {
            "type": "object",
            "properties": {
              "kind": { "const": "FIELD_REF" },
              "object": { "$ref": "#/$defs/Expression" },
              "field": { "type": "string" }
            },
            "required": ["kind", "object", "field"],
            "additionalProperties": false
          },
          "Expression": {
            "oneOf": [
              { "$ref": "#/$defs/AsShared" },
              { "$ref": "#/$defs/FieldReference" },
              { "$ref": "#/$defs/FunctionCall" },
              { "$ref": "#/$defs/IntegerLiteral" },
              { "$ref": "#/$defs/MemoryAllocation" },
              { "$ref": "#/$defs/MemoryRetention" },
              { "$ref": "#/$defs/StringLiteral" },
              { "$ref": "#/$defs/TruthLiteral" },
              { "$ref": "#/$defs/VariableReference" }
            ]
          },
          "AsShared": {
            "type": "object",
            "properties": {
              "kind": { "const": "AS_SHARED" },
              "object": { "$ref": "#/$defs/FunctionCall" }
            },
            "required": ["kind", "object"],
            "additionalProperties": false
          },
          "FunctionCall": {
            "type": "object",
            "properties": {
              "kind": { "const": "CALL" },
              "receiver": {
                "oneOf": [
                  { "$ref": "#/$defs/__type__type" },
                  { "$ref": "#/$defs/__type__type.o1" }
                ],
                "discriminator": {
                  "mapping": {
                    "direct": "#/components/schemas/__type__type",
                    "inherited": "#/components/schemas/__type__type.o1"
                  },
                  "propertyName": "dispatch"
                }
              },
              "name": {
                "type": "object",
                "properties": {
                  "namespace": { "type": "string" },
                  "baseName": { "type": "string" },
                  "labels": { "type": "array", "items": { "type": "string" } }
                },
                "required": ["baseName", "labels"],
                "additionalProperties": false
              },
              "arguments": {
                "type": "array",
                "items": { "$ref": "#/$defs/Expression" }
              }
            },
            "required": ["kind", "name", "arguments"],
            "additionalProperties": false
          },
          "__type__type": {
            "type": "object",
            "properties": {
              "object": { "$ref": "#/$defs/Storage" },
              "dispatch": { "const": "direct" },
              "type": { "$ref": "#/$defs/CanonicalName" }
            },
            "required": ["object", "dispatch", "type"],
            "additionalProperties": false
          },
          "CanonicalName": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "namespace": { "type": "string" }
            },
            "required": ["name"],
            "additionalProperties": false
          },
          "__type__type.o1": {
            "type": "object",
            "properties": {
              "object": { "$ref": "#/$defs/Storage" },
              "dispatch": { "const": "inherited" },
              "declaredIn": { "$ref": "#/$defs/CanonicalName" }
            },
            "required": ["object", "dispatch", "declaredIn"],
            "additionalProperties": false
          },
          "IntegerLiteral": {
            "type": "object",
            "properties": {
              "kind": { "const": "INTEGER_LITERAL" },
              "value": { "type": "string" }
            },
            "required": ["kind", "value"],
            "additionalProperties": false
          },
          "MemoryAllocation": {
            "type": "object",
            "properties": {
              "kind": { "const": "ALLOCATION" },
              "type": { "$ref": "#/$defs/CanonicalName" },
              "base": { "$ref": "#/$defs/CanonicalName" },
              "isolationLevel": { "$ref": "#/$defs/IsolationLevel" },
              "fields": {
                "type": "array",
                "items": { "$ref": "#/$defs/__type.o1" }
              }
            },
            "required": ["kind", "type", "isolationLevel", "fields"],
            "additionalProperties": false
          },
          "IsolationLevel": {
            "oneOf": [{ "const": "ISOLATED" }, { "const": "SHARED" }]
          },
          "__type.o1": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "value": { "$ref": "#/$defs/Expression" }
            },
            "required": ["name", "value"],
            "additionalProperties": false
          },
          "MemoryRetention": {
            "type": "object",
            "properties": {
              "kind": { "const": "RETAIN" },
              "object": { "$ref": "#/$defs/Storage" }
            },
            "required": ["kind", "object"],
            "additionalProperties": false
          },
          "StringLiteral": {
            "type": "object",
            "properties": {
              "kind": { "const": "STRING_LITERAL" },
              "value": { "type": "string" }
            },
            "required": ["kind", "value"],
            "additionalProperties": false
          },
          "TruthLiteral": {
            "type": "object",
            "properties": {
              "kind": { "const": "TRUTHVALUE_LITERAL" },
              "value": {
                "oneOf": [
                  { "const": "ambiguous" },
                  { "const": "false" },
                  { "const": "true" }
                ]
              }
            },
            "required": ["kind", "value"],
            "additionalProperties": false
          },
          "VariableReference": {
            "type": "object",
            "properties": {
              "kind": { "const": "VARIABLE_REF" },
              "name": { "type": "string" }
            },
            "required": ["kind", "name"],
            "additionalProperties": false
          },
          "EnsureUnique": {
            "type": "object",
            "properties": {
              "kind": { "const": "ENSURE_UNIQUE" },
              "object": { "$ref": "#/$defs/Storage" }
            },
            "required": ["kind", "object"],
            "additionalProperties": false
          },
          "Release": {
            "type": "object",
            "properties": {
              "kind": { "const": "RELEASE" },
              "object": { "$ref": "#/$defs/Storage" }
            },
            "required": ["kind", "object"],
            "additionalProperties": false
          },
          "Return": {
            "type": "object",
            "properties": {
              "kind": { "const": "RETURN" },
              "value": {
                "oneOf": [
                  { "$ref": "#/$defs/AsShared" },
                  { "$ref": "#/$defs/FieldReference" },
                  { "$ref": "#/$defs/FunctionCall" },
                  { "$ref": "#/$defs/IntegerLiteral" },
                  { "$ref": "#/$defs/MemoryAllocation" },
                  { "$ref": "#/$defs/MemoryRetention" },
                  { "$ref": "#/$defs/StringLiteral" },
                  { "$ref": "#/$defs/TruthLiteral" },
                  { "$ref": "#/$defs/VariableReference" }
                ]
              }
            },
            "required": ["kind"],
            "additionalProperties": false
          },
          "VariableDeclaration": {
            "type": "object",
            "properties": {
              "kind": { "const": "VARIABLE_DECL" },
              "name": { "type": "string" },
              "valueSet": { "$ref": "#/$defs/ValueSet" },
              "initialValue": { "$ref": "#/$defs/Expression" }
            },
            "required": ["kind", "name", "valueSet", "initialValue"],
            "additionalProperties": false
          },
          "ValueSet": {
            "oneOf": [
              { "$ref": "#/$defs/IntegerValueSet" },
              { "$ref": "#/$defs/RcTypeValueSet" },
              { "$ref": "#/$defs/RealValueSet" },
              { "$ref": "#/$defs/StringValueSet" },
              { "$ref": "#/$defs/TruthValueSet" }
            ]
          },
          "IntegerValueSet": {
            "type": "object",
            "properties": {
              "type": { "const": "integer" },
              "min": { "type": "string", "pattern": "^-?\\d+$" },
              "max": { "type": "string", "pattern": "^-?\\d+$" }
            },
            "required": ["type"],
            "additionalProperties": false
          },
          "RcTypeValueSet": {
            "type": "object",
            "properties": {
              "type": { "const": "rc-type" },
              "namespace": { "type": "string" },
              "typeName": { "type": "string" }
            },
            "required": ["type", "typeName"],
            "additionalProperties": false
          },
          "RealValueSet": {
            "type": "object",
            "properties": {
              "type": { "const": "real" },
              "min": { "type": "string" },
              "max": { "type": "string" }
            },
            "required": ["type"],
            "additionalProperties": false
          },
          "StringValueSet": {
            "type": "object",
            "properties": { "type": { "const": "string" } },
            "required": ["type"],
            "additionalProperties": false
          },
          "TruthValueSet": {
            "type": "object",
            "properties": {
              "type": { "const": "truthvalue" },
              "values": {
                "type": "array",
                "items": {
                  "oneOf": [
                    { "const": "ambiguous" },
                    { "const": "false" },
                    { "const": "true" }
                  ]
                }
              }
            },
            "required": ["type", "values"],
            "additionalProperties": false
          },
          "Declaration": {
            "oneOf": [
              { "$ref": "#/$defs/__typeVariableDeclaration" },
              { "$ref": "#/$defs/__type__type.o2" },
              { "$ref": "#/$defs/__type__typeFunctionSignature" },
              { "$ref": "#/$defs/__type__type__type" }
            ]
          },
          "__typeVariableDeclaration": {
            "type": "object",
            "properties": {
              "kind": { "const": "VARIABLE_DECL" },
              "name": { "type": "string" },
              "valueSet": { "$ref": "#/$defs/ValueSet" },
              "initialValue": { "$ref": "#/$defs/Expression" },
              "namespace": { "type": "string" }
            },
            "required": ["kind", "name", "valueSet", "initialValue"],
            "additionalProperties": false
          },
          "__type__type.o2": {
            "type": "object",
            "properties": {
              "namespace": { "type": "string" },
              "kind": { "const": "TYPE_DECL" },
              "name": { "type": "string" },
              "fields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string" },
                    "valueSet": { "$ref": "#/$defs/ValueSet" }
                  },
                  "required": ["name", "valueSet"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["kind", "name", "fields"],
            "additionalProperties": false
          },
          "__type__typeFunctionSignature": {
            "type": "object",
            "properties": {
              "kind": { "const": "FUNCTION_DECL" },
              "body": {
                "type": "array",
                "items": { "$ref": "#/$defs/Statement" }
              },
              "baseName": { "type": "string" },
              "labels": { "type": "array", "items": { "type": "string" } },
              "parameters": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string" },
                    "valueSet": { "$ref": "#/$defs/ValueSet" }
                  },
                  "required": ["name", "valueSet"],
                  "additionalProperties": false
                }
              },
              "resultValueSet": {
                "oneOf": [
                  { "$ref": "#/$defs/IntegerValueSet" },
                  { "$ref": "#/$defs/RcTypeValueSet" },
                  { "$ref": "#/$defs/RealValueSet" },
                  { "$ref": "#/$defs/StringValueSet" },
                  { "$ref": "#/$defs/TruthValueSet" }
                ]
              },
              "namespace": { "type": "string" }
            },
            "required": ["kind", "body", "baseName", "labels", "parameters"],
            "additionalProperties": false
          },
          "__type__type__type": {
            "type": "object",
            "properties": {
              "namespace": { "type": "string" },
              "kind": { "const": "TYPE_DECL" },
              "name": { "type": "string" },
              "fields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string" },
                    "valueSet": { "$ref": "#/$defs/ValueSet" }
                  },
                  "required": ["name", "valueSet"],
                  "additionalProperties": false
                }
              },
              "base": { "$ref": "#/$defs/CanonicalName" },
              "methods": {
                "type": "array",
                "items": { "$ref": "#/$defs/FunctionDeclaration" }
              },
              "initializers": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/OmitFunctionDeclarationresultValueSet"
                }
              },
              "dispatchTable": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "slot": { "$ref": "#/$defs/FunctionSignature" },
                    "declaredIn": { "$ref": "#/$defs/CanonicalName" },
                    "implementedBy": { "$ref": "#/$defs/CanonicalName" }
                  },
                  "required": ["slot", "declaredIn"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["kind", "name", "fields", "methods"],
            "additionalProperties": false
          },
          "FunctionDeclaration": {
            "type": "object",
            "properties": {
              "kind": { "const": "FUNCTION_DECL" },
              "body": {
                "type": "array",
                "items": { "$ref": "#/$defs/Statement" }
              },
              "baseName": { "type": "string" },
              "labels": { "type": "array", "items": { "type": "string" } },
              "parameters": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string" },
                    "valueSet": { "$ref": "#/$defs/ValueSet" }
                  },
                  "required": ["name", "valueSet"],
                  "additionalProperties": false
                }
              },
              "resultValueSet": {
                "oneOf": [
                  { "$ref": "#/$defs/IntegerValueSet" },
                  { "$ref": "#/$defs/RcTypeValueSet" },
                  { "$ref": "#/$defs/RealValueSet" },
                  { "$ref": "#/$defs/StringValueSet" },
                  { "$ref": "#/$defs/TruthValueSet" }
                ]
              }
            },
            "required": ["kind", "body", "baseName", "labels", "parameters"],
            "additionalProperties": false
          },
          "OmitFunctionDeclarationresultValueSet": {
            "type": "object",
            "properties": {
              "kind": { "const": "FUNCTION_DECL" },
              "body": {
                "type": "array",
                "items": { "$ref": "#/$defs/Statement" }
              },
              "baseName": { "type": "string" },
              "labels": { "type": "array", "items": { "type": "string" } },
              "parameters": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string" },
                    "valueSet": { "$ref": "#/$defs/ValueSet" }
                  },
                  "required": ["name", "valueSet"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["kind", "body", "baseName", "labels", "parameters"],
            "additionalProperties": false
          },
          "FunctionSignature": {
            "type": "object",
            "properties": {
              "baseName": { "type": "string" },
              "labels": { "type": "array", "items": { "type": "string" } },
              "parameters": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string" },
                    "valueSet": { "$ref": "#/$defs/ValueSet" }
                  },
                  "required": ["name", "valueSet"],
                  "additionalProperties": false
                }
              },
              "resultValueSet": {
                "oneOf": [
                  { "$ref": "#/$defs/IntegerValueSet" },
                  { "$ref": "#/$defs/RcTypeValueSet" },
                  { "$ref": "#/$defs/RealValueSet" },
                  { "$ref": "#/$defs/StringValueSet" },
                  { "$ref": "#/$defs/TruthValueSet" }
                ]
              }
            },
            "required": ["baseName", "labels", "parameters"],
            "additionalProperties": false
          }
        }
      }
    }
  ],
  "C_Cpp.default.includePath": ["src/runtime/include"]
}
