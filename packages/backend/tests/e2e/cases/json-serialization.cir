# yaml-language-server: $schema=../../../../../schema/cir.schema.json
$schema: http://clawr.lang/schema/cir/DRAFT-0
declarations:
  - kind: INTERFACE_DECL
    name: Writable
    methods:
      - baseName: serialize
        labels: [into]
        parameters:
          - name: buffer
            type: {universe: rc-type, name: JSONBuffer, namespace: clawr}
        returnType: {universe: void}
  - kind: RC_TYPE_DECL
    name: Point
    properties:
      - name: number
        type: {universe: integer}
  - kind: EXTENSION_DECL
    target: {name: Point}
    conformances:
      - interface: {name: Writable}
        fulfillments:
          - requirement: {baseName: serialize, labels: [into]}
            implementation: {baseName: serialize, labels: [into]}
    methods:
      - kind: FUNCTION_DECL
        baseName: serialize
        labels: [into]
        parameters:
          - name: buffer
            type: {universe: rc-type, name: JSONBuffer, namespace: clawr}
        returnType: {universe: void}
        body:
          - kind: CALL
            name: {baseName: jsonBeginStructure, labels: [fieldCount], namespace: clawr}
            arguments:
              - kind: VARIABLE_REF
                name: buffer
                type: {universe: rc-type, name: JSONBuffer, namespace: clawr}
              - kind: INTEGER_LITERAL
                type: {universe: integer, value: '1'}
          - kind: CALL
            name: {baseName: jsonBeginField, labels: [name], namespace: clawr}
            arguments:
              - kind: VARIABLE_REF
                name: buffer
                type: {universe: rc-type, name: JSONBuffer, namespace: clawr}
              - kind: STRING_LITERAL
                type: {universe: string, value: number}
          - kind: CALL
            name: {baseName: jsonWriteInteger, labels: [value], namespace: clawr}
            arguments:
              - kind: VARIABLE_REF
                name: buffer
                type: {universe: rc-type, name: JSONBuffer, namespace: clawr}
              - kind: PROPERTY_REF
                object:
                  kind: VARIABLE_REF
                  name: self
                  type: {universe: rc-type, name: Point}
                property: number
                type: {universe: integer}
          - kind: CALL
            name: {baseName: jsonEndField, labels: [], namespace: clawr}
            arguments:
              - kind: VARIABLE_REF
                name: buffer
                type: {universe: rc-type, name: JSONBuffer, namespace: clawr}
          - kind: CALL
            name: {baseName: jsonEndStructure, labels: [], namespace: clawr}
            arguments:
              - kind: VARIABLE_REF
                name: buffer
                type: {universe: rc-type, name: JSONBuffer, namespace: clawr}
  - kind: FUNCTION_DECL
    baseName: encode
    labels: []
    parameters:
      - name: value
        type: {universe: interface, name: Writable}
    returnType: {universe: string}
    body:
      - kind: VARIABLE_DECL
        name: buffer
        type: {universe: rc-type, name: JSONBuffer, namespace: clawr}
        initialValue:
          kind: CALL
          name: {baseName: newJSONBuffer, labels: [], namespace: clawr}
          arguments: []
          type: {universe: rc-type, name: JSONBuffer, namespace: clawr}
      - kind: CALL
        name: {baseName: serialize, labels: [into]}
        receiver:
          dispatch: conformance
          object:
            kind: VARIABLE_REF
            name: value
            type: {universe: interface, name: Writable}
        arguments:
          - kind: VARIABLE_REF
            name: buffer
            type: {universe: rc-type, name: JSONBuffer, namespace: clawr}
      - kind: VARIABLE_DECL
        name: text
        type: {universe: string}
        initialValue:
          kind: CALL
          name: {baseName: jsonResult, labels: [], namespace: clawr}
          arguments:
            - kind: VARIABLE_REF
              name: buffer
              type: {universe: rc-type, name: JSONBuffer, namespace: clawr}
          type: {universe: string}
      - kind: RELEASE
        object: {kind: VARIABLE_REF, name: buffer}
      - kind: RETURN
        value:
          kind: VARIABLE_REF
          name: text
          type: {universe: string}
startBlock:
  - kind: VARIABLE_DECL
    name: point
    type: {universe: rc-type, name: Point}
    initialValue:
      kind: ALLOCATION
      type: {universe: rc-type, name: Point}
      isolationLevel: ISOLATED
      properties:
        - name: number
          value:
            kind: INTEGER_LITERAL
            type: {universe: integer, value: '9007199254740993'}
  - kind: CALL
    name: {baseName: print, labels: []}
    arguments:
      - kind: CALL
        name: {baseName: encode, labels: []}
        arguments:
          - kind: VARIABLE_REF
            name: point
            type: {universe: rc-type, name: Point}
        type: {universe: string}
  - kind: RELEASE
    object: {kind: VARIABLE_REF, name: point}
