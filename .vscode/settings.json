{
  "[c]": { "editor.defaultFormatter": "ms-vscode.cpptools" },
  "C_Cpp.clang_format_style": "file",
  "C_Cpp.clang_format_fallbackStyle": "LLVM",
  "C_Cpp.default.includePath": ["packages/runtime/src/include"],
  "C_Cpp.formatting": "clangFormat",
  // Workaround for microsoft/vscode-js-debug#2462: extension host aborts on
  // F5 launch ("Cannot toggle network tracking, please report this.")
  "debug.javascript.enableNetworkView": false,
  "editor.codeActionsOnSave": { "source.organizeImports": "always" },
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "editor.suggest.insertMode": "replace",
  "files.associations": {
    "*.cir": "yaml"
  },
  "chat.tools.terminal.autoApprove": {
    "npm run build": true,
    "npm test": true,
    "bun": true
  }
}
