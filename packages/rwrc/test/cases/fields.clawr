
data Inner {
    property: integer(0..<100)
}

data Outer {
    property1: integer(0..<100)
    ref inner: Inner
}

@main {
    ref a: Outer = { property1: 42, inner: { property: 47 } }
    ref b = a

    const c = copy(of: a)
    mut d = c

    b->property1 = 0 // changes a
    d.property1 = 1 // only chsnges d

    print(a->property1)
    print(c.property1)

    ref e = c.inner
    b->inner->property = 3

    print(e->property)
}
