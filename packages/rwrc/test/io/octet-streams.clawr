func readSome(_ input: ref OctetInput, _ count: integer) -> bitfield {
    return readOctets(input, count: count)
}

@main {
    const output = openOctetOutput("data.bin")
    writeOctets(output, value: 0x00_80_FF_01)
    writeOctets(output, value: bitfield("101010100101010101111111111111101000000101000000000000101100001100001001"))
    writeOctets(output, value: bitfield(""))
    closeOctetOutput(output)

    const input = openOctetInput("data.bin")
    const first: bitfield(24) = readSome(input, 3)
    const next = readOctets(input, count: 1)
    const last = readSome(input, 20)
    print(first == bitfield("000000001000000011111111"))
    print(next == bitfield("00000001"))
    print(fieldLength(last) == 72)
    const all = fieldConcat(fieldConcat(first, next), last)
    print(fieldLength(all) == 104)
    print(fieldSlice(all, 8, 8) == bitfield("10000000"))
    print(readOctets(input, count: 1) == bitfield(""))
    print(readSome(input, 3) == bitfield(""))
    closeOctetInput(input)

    const aliasSource = openOctetInput("data.bin")
    const alias = aliasSource
    print(readSome(aliasSource, 1) == bitfield("00000000"))
    print(readSome(alias, 1) == bitfield("10000000"))
    closeOctetInput(alias)
    readOctets(openOctetInput("data.bin"), count: 1)

    const source = openOctetInput("data.bin")
    const destination = openOctetOutput("copy.bin")
    mut chunk: bitfield = readOctets(source, count: 5)
    while fieldLength(chunk) > 0 {
        writeOctets(destination, value: chunk)
        chunk = readOctets(source, count: 5)
    }
    closeOctetInput(source)
    closeOctetOutput(destination)
}
