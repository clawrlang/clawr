data MyData {
    property: integer
}

const c: MyData = { property: 1 }
const r: ref MyData = copy(of: c)

@main {
    mut m: MyData = c
    m.property = 2 // isolated mutation

    mut mr: ref MyData = r
    r->property = 3 // shared mutation

    print(c.property)
    print(m.property)
    print(mr->property)
    print(r->property)
}
