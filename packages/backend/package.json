{
  "name": "@clawr/backend",
  "version": "0.1.0",
  "description": "Clawr compiler backend: an executable that consumes CIR and lowers it to a target platform.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "pretest": "npm run build",
    "test": "bun test ./tests",
    "pretest:unit": "ttsc",
    "test:unit": "tsc --noEmit && BUN_JSC_useTailCalls=0 bun test ./tests/unit",
    "build": "ttsc",
    "start": "node ./dist/cli.js"
  },
  "dependencies": {
    "@clawr/cir": "^0.1.0",
    "ajv": "^8.17.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "bun": "^1.4.0",
    "ttsc": "^0.28.4",
    "typescript": "^7.0.0"
  }
}
