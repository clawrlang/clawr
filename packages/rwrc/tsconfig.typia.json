{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./.typia-temp",
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "plugins": [
      { "transform": "typia/lib/transform" },
      { "transform": "@ttsc/paths" }
    ]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", ".typia-temp"]
}
