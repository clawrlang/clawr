{
  "name": "clawr",
  "version": "0.1.0",
  "description": "Clawr Semantic Library",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "tsc --noEmit && bun test ./tests/unit/",
    "build:runtime": "rm -rf dist/include && bun run cp -R src/runtime/include dist/include && clang -I dist/include src/runtime/*.c -dynamiclib -fvisibility=hidden -current_version 0.0.1 -compatibility_version 0.0.1 -o dist/libClawr.A.dylib",
    "test:runtime": "npm run build:runtime && bun test ./tests/runtime/*.test.ts"
  },
  "author": "Clawr Community",
  "license": "MIT",
  "dependencies": {
    "commander": "^15.0.0",
    "decimalish": "^0.1.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.1",
    "bun": "^1.3.14",
    "eslint": "^10.4.1",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3"
  }
}
