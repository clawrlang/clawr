# yaml-language-server: $schema=../../../../../cir-schema/cir.schema.json
$schema: http://clawr.lang/schema/cir/DRAFT-0
declarations:
  - kind: RC_TYPE_DECL
    name: FooData
    properties:
      - name: bar
        type:
          universe: integer
  - kind: VARIABLE_DECL
    name: foo
    type:
      universe: rc-type
      name: FooData
    initialValue:
      kind: ALLOCATION
      type:
        universe: rc-type
        name: FooData
      isolationLevel: SHARED
      properties:
        - name: bar
          value:
            kind: INTEGER_LITERAL
            type:
              universe: integer
              value: '2'
startBlock:
  - kind: ASSIGN
    target:
      kind: PROPERTY_REF
      object:
        kind: VARIABLE_REF
        name: foo
        type:
          universe: rc-type
          name: FooData
      property: bar
    value:
      kind: INTEGER_LITERAL
      type:
        universe: integer
        value: '1'
  - kind: VARIABLE_DECL
    name: __tempˇ0
    initialValue:
      kind: BOX
      expression:
        kind: PROPERTY_REF
        object:
          kind: VARIABLE_REF
          name: foo
          type:
            universe: rc-type
            name: FooData
        property: bar
        type:
          universe: integer
      type:
        universe: integer
        boxed: true
    type:
      universe: integer
      boxed: true
  - kind: CALL
    name:
      baseName: print
      labels: []
    arguments:
      - kind: VARIABLE_REF
        name: __tempˇ0
        type:
          universe: integer
          boxed: true
  - kind: RELEASE
    object:
      kind: VARIABLE_REF
      name: __tempˇ0
  - kind: RELEASE
    object:
      kind: VARIABLE_REF
      name: foo
