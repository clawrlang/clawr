{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["bun-types"],
    "outDir": "./dist",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "plugins": [{ "transform": "@ttsc/paths" }],
    "paths": {
      "@/*": ["./src/*"],
      "@@/*": ["./tests/*"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
