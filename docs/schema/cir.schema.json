{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://example.com/schema/cir",
  "title": "Clawr Module",
  "type": "object",
  "properties": {
    "$schema": {
      "enum": [
        "http://clawr.lang/schema/cir/DRAFT-0",
        "../../../docs/schema/cir.schema.json"
      ]
    },
    "startBlock": {
      "type": "array",
      "items": { "$ref": "#/definitions/statement" }
    },
    "declarations": {
      "type": "array",
      "items": { "$ref": "#/definitions/declaration" }
    }
  },
  "required": ["$schema"],
  "additionalProperties": false,
  "definitions": {
    "declaration": {
      "oneOf": [
        { "$ref": "#/definitions/variable_declaration" },
        {
          "type": "object",
          "title": "Data Declaration",
          "properties": {
            "kind": { "const": "DATA_DECL" },
            "name": { "type": "string" },
            "fields": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "type": { "type": "string" }
                },
                "required": ["name", "type"],
                "additionalProperties": false
              }
            }
          },
          "required": ["kind", "name", "fields"],
          "additionalProperties": false
        }
      ]
    },
    "variable_declaration": {
      "type": "object",
      "title": "Variable Declaration",
      "properties": {
        "kind": { "const": "VARIABLE_DECL" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "initialValue": { "$ref": "#/definitions/expression" }
      },
      "required": ["kind", "name", "type", "initialValue"],
      "additionalProperties": false
    },
    "statement": {
      "oneOf": [
        {
          "type": "object",
          "title": "Assign Fields",
          "properties": {
            "kind": { "const": "ASSIGN_FIELDS" },
            "target": {
              "oneOf": [
                { "$ref": "#/definitions/variable_reference" },
                { "$ref": "#/definitions/field_reference" }
              ]
            },
            "fields": { "$ref": "#/definitions/data_literal" }
          },
          "required": ["kind", "target", "fields"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "Ensure Unique",
          "properties": {
            "kind": { "const": "ENSURE_UNIQUE" },
            "object": {
              "oneOf": [
                { "$ref": "#/definitions/variable_reference" },
                { "$ref": "#/definitions/field_reference" }
              ]
            }
          },
          "required": ["kind", "object"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "Retain",
          "properties": {
            "kind": { "const": "RETAIN" },
            "object": {
              "oneOf": [
                { "$ref": "#/definitions/variable_reference" },
                { "$ref": "#/definitions/field_reference" }
              ]
            }
          },
          "required": ["kind", "object"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "Release",
          "properties": {
            "kind": { "const": "RELEASE" },
            "object": {
              "oneOf": [
                { "$ref": "#/definitions/variable_reference" },
                { "$ref": "#/definitions/field_reference" }
              ]
            }
          },
          "required": ["kind", "object"],
          "additionalProperties": false
        },
        { "$ref": "#/definitions/call_func" },
        { "$ref": "#/definitions/variable_declaration" },
        { "$ref": "#/definitions/assignment" }
      ]
    },
    "call_func": {
      "type": "object",
      "properties": {
        "kind": { "const": "CALL_FUNC" },
        "signature": {
          "type": "object",
          "properties": {
            "baseName": { "type": "string" },
            "parameters": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "label": { "type": "string" },
                  "type": { "type": "string" }
                },
                "required": ["type"],
                "additionalProperties": false
              }
            }
          },
          "required": ["baseName", "parameters"],
          "additionalProperties": false
        },
        "arguments": {
          "type": "array",
          "items": { "$ref": "#/definitions/expression" }
        }
      },
      "required": ["kind", "signature", "arguments"],
      "additionalProperties": false
    },
    "assignment": {
      "type": "object",
      "properties": {
        "kind": { "const": "ASSIGN" },
        "target": {
          "oneOf": [
            { "$ref": "#/definitions/variable_reference" },
            { "$ref": "#/definitions/field_reference" }
          ]
        },
        "value": { "$ref": "#/definitions/expression" }
      },
      "required": ["kind", "target", "value"],
      "additionalProperties": false
    },
    "expression": {
      "oneOf": [
        {
          "type": "object",
          "title": "String Literal",
          "properties": {
            "kind": { "const": "STRING_LITERAL" },
            "value": { "type": "string" }
          },
          "required": ["kind", "value"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "Integer Literal",
          "properties": {
            "kind": { "const": "INTEGER_LITERAL" },
            "value": { "type": "string", "pattern": "^-?\\d+$" }
          },
          "required": ["kind", "value"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "Truth Value Literal",
          "properties": {
            "kind": { "const": "TRUTHVALUE_LITERAL" },
            "value": {
              "oneOf": [
                { "const": "false" },
                { "const": "ambiguous" },
                { "const": "true" }
              ]
            }
          },
          "required": ["kind", "value"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "Allocation",
          "properties": {
            "kind": { "const": "ALLOCATE" },
            "type": { "type": "string" },
            "semantics": {
              "description": "Specifies the allocation semantics",
              "type": "string",
              "enum": ["REF", "COW"]
            }
          },
          "required": ["kind", "type", "semantics"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "Copy",
          "properties": {
            "kind": { "const": "COPY" },
            "object": { "$ref": "#/definitions/expression" }
          },
          "required": ["kind", "object"],
          "additionalProperties": false
        },
        { "$ref": "#/definitions/variable_reference" },
        { "$ref": "#/definitions/data_literal" },
        { "$ref": "#/definitions/field_reference" },
        { "$ref": "#/definitions/call_func" }
      ]
    },
    "data_literal": {
      "type": "object",
      "properties": {
        "kind": { "const": "DATA_LITERAL" },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "value": { "$ref": "#/definitions/expression" }
            },
            "required": ["name", "value"],
            "additionalProperties": false
          }
        }
      },
      "required": ["kind", "fields"],
      "additionalProperties": false
    },
    "field_reference": {
      "type": "object",
      "title": "Field Reference",
      "properties": {
        "kind": { "const": "FIELD_REF" },
        "object": {
          "$ref": "#/definitions/expression"
        },
        "field": { "type": "string" }
      },
      "required": ["kind", "object", "field"],
      "additionalProperties": false
    },
    "variable_reference": {
      "type": "object",
      "title": "Variable Reference",
      "properties": {
        "kind": { "const": "VARIABLE_REF" },
        "name": { "type": "string" }
      },
      "required": ["kind", "name"],
      "additionalProperties": false
    }
  }
}
