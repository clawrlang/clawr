trait HasValue {
    func value() -> integer
}

data Counter {
    value: integer
}

extension Counter: HasValue {
    func value() => self->value
}

extension Counter {
    func doubled() => self->value * 2
mutating:
    func increment() {
        self->value = self->value + 1
    }
}

object Marker {
init:
    func new() => {}
}

role HasMarker {
    func markerValue() -> integer
}

role HasTag {
    func tag() -> integer
}

extension Marker: HasMarker {
    func markerValue() => 9
}

object ExtensionMarker: HasTag {
init:
    func new() => {}
}

extension ExtensionMarker {
    func tag() => 8
}

object ChildMarker: Marker {
init:
    func new() => {Marker.new()}
}

func read(_ value: HasValue) -> integer {
    return value.value()
}

func readMarker(_ value: HasMarker) -> integer {
    return value.markerValue()
}

func readTag(_ value: HasTag) -> integer {
    return value.tag()
}

@main {
    const original: Counter = {value: 1}
    mut counter: Counter = original
    counter.increment()

    const marker: Marker = {Marker.new()}
    const childMarker: ChildMarker = {ChildMarker.new()}
    const extensionMarker: ExtensionMarker = {ExtensionMarker.new()}
    print(original.value)
    print(counter.doubled())
    print(read(counter))
    print(serializeJSON(counter))
    print(marker.markerValue())
    print(readMarker(childMarker))
    print(readTag(extensionMarker))
}
