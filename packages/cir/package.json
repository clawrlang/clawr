{
  "name": "@clawr/cir",
  "version": "0.1.0",
  "description": "Clawr Intermediate Representation (CIR): the data structures that define the interface between Clawr compiler frontends and backends.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./cir.schema.json": "./cir.schema.json",
    "./declarations.json": "./declarations.json",
    "./statements.json": "./statements.json",
    "./expressions.json": "./expressions.json",
    "./valuesets.json": "./valuesets.json"
  },
  "files": [
    "dist",
    "cir.schema.json",
    "valuesets.json"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "decimalish": "^0.1.2",
    "prettier": "^3.9.9"
  },
  "devDependencies": {
    "typescript": "^7.0.0"
  }
}
