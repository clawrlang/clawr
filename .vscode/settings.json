{
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "files.associations": { "*.cir": "json" },
  "json.schemas": [
    {
      "url": "http://clawr.lang/schema/cir/DRAFT-0",
      "schema": {
        "type": "object",
        "properties": {
          "$schema": { "const": "http://clawr.lang/schema/cir/DRAFT-0" },
          "startBlock": {
            "type": "array",
            "items": { "$ref": "#/$defs/Statement" }
          },
          "declarations": {
            "type": "array",
            "items": { "$ref": "#/$defs/Declaration" }
          }
        },
        "required": ["$schema"],
        "additionalProperties": false,
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$defs": {
          "ClawrModule": {
            "type": "object",
            "properties": {
              "$schema": { "const": "http://clawr.lang/schema/cir/DRAFT-0" },
              "startBlock": {
                "type": "array",
                "items": { "$ref": "#/$defs/Statement" }
              },
              "declarations": {
                "type": "array",
                "items": { "$ref": "#/$defs/Declaration" }
              }
            },
            "required": ["$schema"],
            "additionalProperties": false
          },
          "Statement": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": { "const": "VARIABLE_DECL" },
                  "name": { "type": "string" },
                  "valueSet": { "$ref": "#/$defs/ValueSet" },
                  "initialValue": { "$ref": "#/$defs/Expression" }
                },
                "required": ["kind", "name", "valueSet", "initialValue"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": { "const": "ENSURE_UNIQUE" },
                  "object": { "$ref": "#/$defs/Expression" }
                },
                "required": ["kind", "object"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": { "const": "RELEASE" },
                  "object": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "kind": { "const": "VARIABLE_REF" },
                          "name": { "type": "string" },
                          "valueSet": { "$ref": "#/$defs/ValueSet" }
                        },
                        "required": ["kind", "name", "valueSet"],
                        "additionalProperties": false
                      },
                      { "$ref": "#/$defs/__type.o13" }
                    ]
                  }
                },
                "required": ["kind", "object"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": { "const": "EXEC" },
                  "name": {
                    "type": "object",
                    "properties": {
                      "baseName": { "type": "string" },
                      "labels": {
                        "type": "array",
                        "items": { "type": "string" }
                      }
                    },
                    "required": ["baseName", "labels"],
                    "additionalProperties": false
                  },
                  "arguments": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/Expression" }
                  }
                },
                "required": ["kind", "name", "arguments"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": { "const": "RETURN" },
                  "value": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "kind": { "const": "TRUTHVALUE_LITERAL" },
                          "value": {
                            "oneOf": [
                              { "const": "ambiguous" },
                              { "const": "false" },
                              { "const": "true" }
                            ]
                          },
                          "valueSet": {
                            "type": "object",
                            "properties": {
                              "type": { "const": "truthvalue" },
                              "values": {
                                "type": "array",
                                "items": {
                                  "oneOf": [
                                    { "const": "ambiguous" },
                                    { "const": "false" },
                                    { "const": "true" }
                                  ]
                                }
                              }
                            },
                            "required": ["type"],
                            "additionalProperties": false
                          }
                        },
                        "required": ["kind", "value", "valueSet"],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "kind": { "const": "INTEGER_LITERAL" },
                          "value": { "type": "string" },
                          "valueSet": {
                            "type": "object",
                            "properties": {
                              "type": { "const": "integer" },
                              "min": { "type": "string" },
                              "max": { "type": "string" }
                            },
                            "required": ["type"],
                            "additionalProperties": false
                          }
                        },
                        "required": ["kind", "value", "valueSet"],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "kind": { "const": "STRING_LITERAL" },
                          "value": { "type": "string" },
                          "valueSet": {
                            "type": "object",
                            "properties": { "type": { "const": "string" } },
                            "required": ["type"],
                            "additionalProperties": false
                          }
                        },
                        "required": ["kind", "value", "valueSet"],
                        "additionalProperties": false
                      },
                      { "$ref": "#/$defs/__type.o9" },
                      { "$ref": "#/$defs/__type.o11" },
                      {
                        "type": "object",
                        "properties": {
                          "kind": { "const": "VARIABLE_REF" },
                          "name": { "type": "string" },
                          "valueSet": { "$ref": "#/$defs/ValueSet" }
                        },
                        "required": ["kind", "name", "valueSet"],
                        "additionalProperties": false
                      },
                      { "$ref": "#/$defs/__type.o13" },
                      { "$ref": "#/$defs/__type.o14" }
                    ]
                  }
                },
                "required": ["kind"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": { "const": "ASSIGN" },
                  "target": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "kind": { "const": "VARIABLE_REF" },
                          "name": { "type": "string" },
                          "valueSet": { "$ref": "#/$defs/ValueSet" }
                        },
                        "required": ["kind", "name", "valueSet"],
                        "additionalProperties": false
                      },
                      { "$ref": "#/$defs/__type.o13" }
                    ]
                  },
                  "value": { "$ref": "#/$defs/Expression" }
                },
                "required": ["kind", "target", "value"],
                "additionalProperties": false
              }
            ]
          },
          "ValueSet": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": { "const": "integer" },
                  "min": { "type": "string" },
                  "max": { "type": "string" }
                },
                "required": ["type"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": { "const": "truthvalue" },
                  "values": {
                    "type": "array",
                    "items": {
                      "oneOf": [
                        { "const": "ambiguous" },
                        { "const": "false" },
                        { "const": "true" }
                      ]
                    }
                  }
                },
                "required": ["type"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": { "type": { "const": "string" } },
                "required": ["type"],
                "additionalProperties": false
              },
              { "$ref": "#/$defs/__type.o4" }
            ]
          },
          "__type.o4": {
            "type": "object",
            "properties": {
              "type": { "const": "rc-type" },
              "typeName": { "type": "string" },
              "semantics": {
                "oneOf": [
                  { "const": "COW" },
                  { "const": "REF" },
                  { "const": "UNIQUE" }
                ]
              },
              "fields": {
                "type": "array",
                "items": { "$ref": "#/$defs/__type.o5" }
              }
            },
            "required": ["type", "typeName", "semantics"],
            "additionalProperties": false
          },
          "__type.o5": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "valueSet": { "$ref": "#/$defs/ValueSet" }
            },
            "required": ["name", "valueSet"],
            "additionalProperties": false
          },
          "Expression": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": { "const": "STRING_LITERAL" },
                  "value": { "type": "string" },
                  "valueSet": {
                    "type": "object",
                    "properties": { "type": { "const": "string" } },
                    "required": ["type"],
                    "additionalProperties": false
                  }
                },
                "required": ["kind", "value", "valueSet"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": { "const": "INTEGER_LITERAL" },
                  "value": { "type": "string" },
                  "valueSet": {
                    "type": "object",
                    "properties": {
                      "type": { "const": "integer" },
                      "min": { "type": "string" },
                      "max": { "type": "string" }
                    },
                    "required": ["type"],
                    "additionalProperties": false
                  }
                },
                "required": ["kind", "value", "valueSet"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": { "const": "TRUTHVALUE_LITERAL" },
                  "value": {
                    "oneOf": [
                      { "const": "ambiguous" },
                      { "const": "false" },
                      { "const": "true" }
                    ]
                  },
                  "valueSet": {
                    "type": "object",
                    "properties": {
                      "type": { "const": "truthvalue" },
                      "values": {
                        "type": "array",
                        "items": {
                          "oneOf": [
                            { "const": "ambiguous" },
                            { "const": "false" },
                            { "const": "true" }
                          ]
                        }
                      }
                    },
                    "required": ["type"],
                    "additionalProperties": false
                  }
                },
                "required": ["kind", "value", "valueSet"],
                "additionalProperties": false
              },
              { "$ref": "#/$defs/__type.o9" },
              { "$ref": "#/$defs/__type.o11" },
              {
                "type": "object",
                "properties": {
                  "kind": { "const": "VARIABLE_REF" },
                  "name": { "type": "string" },
                  "valueSet": { "$ref": "#/$defs/ValueSet" }
                },
                "required": ["kind", "name", "valueSet"],
                "additionalProperties": false
              },
              { "$ref": "#/$defs/__type.o13" },
              { "$ref": "#/$defs/__type.o14" }
            ]
          },
          "__type.o9": {
            "type": "object",
            "properties": {
              "kind": { "const": "ALLOCATE" },
              "valueSet": { "$ref": "#/$defs/__type.o4" },
              "fields": {
                "type": "array",
                "items": { "$ref": "#/$defs/__type.o10" }
              }
            },
            "required": ["kind", "valueSet", "fields"],
            "additionalProperties": false
          },
          "__type.o10": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "value": { "$ref": "#/$defs/Expression" }
            },
            "required": ["name", "value"],
            "additionalProperties": false
          },
          "__type.o11": {
            "type": "object",
            "properties": {
              "kind": { "const": "RETAIN" },
              "object": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": { "const": "VARIABLE_REF" },
                      "name": { "type": "string" },
                      "valueSet": { "$ref": "#/$defs/ValueSet" }
                    },
                    "required": ["kind", "name", "valueSet"],
                    "additionalProperties": false
                  },
                  { "$ref": "#/$defs/__type.o13" }
                ]
              },
              "valueSet": { "$ref": "#/$defs/__type.o4" }
            },
            "required": ["kind", "object", "valueSet"],
            "additionalProperties": false
          },
          "__type.o13": {
            "type": "object",
            "properties": {
              "kind": { "const": "FIELD_REF" },
              "object": { "$ref": "#/$defs/Expression" },
              "field": { "type": "string" },
              "valueSet": { "$ref": "#/$defs/ValueSet" }
            },
            "required": ["kind", "object", "field", "valueSet"],
            "additionalProperties": false
          },
          "__type.o14": {
            "type": "object",
            "properties": {
              "kind": { "const": "QUERY" },
              "name": {
                "type": "object",
                "properties": {
                  "baseName": { "type": "string" },
                  "labels": { "type": "array", "items": { "type": "string" } }
                },
                "required": ["baseName", "labels"],
                "additionalProperties": false
              },
              "arguments": {
                "type": "array",
                "items": { "$ref": "#/$defs/Expression" }
              },
              "valueSet": { "$ref": "#/$defs/ValueSet" }
            },
            "required": ["kind", "name", "arguments", "valueSet"],
            "additionalProperties": false
          },
          "Declaration": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": { "const": "VARIABLE_DECL" },
                  "name": { "type": "string" },
                  "valueSet": { "$ref": "#/$defs/ValueSet" },
                  "initialValue": { "$ref": "#/$defs/Expression" }
                },
                "required": ["kind", "name", "valueSet", "initialValue"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": { "const": "FUNCTION_DECL" },
                  "baseName": { "type": "string" },
                  "parameters": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "label": { "type": "string" },
                        "varName": { "type": "string" },
                        "valueSet": { "$ref": "#/$defs/ValueSet" }
                      },
                      "required": ["varName", "valueSet"],
                      "additionalProperties": false
                    }
                  },
                  "body": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/Statement" }
                  },
                  "returnValueSet": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "type": { "const": "integer" },
                          "min": { "type": "string" },
                          "max": { "type": "string" }
                        },
                        "required": ["type"],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "type": { "const": "truthvalue" },
                          "values": {
                            "type": "array",
                            "items": {
                              "oneOf": [
                                { "const": "ambiguous" },
                                { "const": "false" },
                                { "const": "true" }
                              ]
                            }
                          }
                        },
                        "required": ["type"],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": { "type": { "const": "string" } },
                        "required": ["type"],
                        "additionalProperties": false
                      },
                      { "$ref": "#/$defs/__type.o4" }
                    ]
                  }
                },
                "required": ["kind", "baseName", "parameters", "body"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": { "const": "DATA_DECL" },
                  "name": { "type": "string" },
                  "fields": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": { "type": "string" },
                        "valueSet": { "$ref": "#/$defs/ValueSet" }
                      },
                      "required": ["name", "valueSet"],
                      "additionalProperties": false
                    }
                  }
                },
                "required": ["kind", "name", "fields"],
                "additionalProperties": false
              }
            ]
          }
        }
      }
    }
  ],
  "C_Cpp.default.includePath": ["src/runtime/include"]
}
