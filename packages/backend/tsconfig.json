{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "plugins": [
      { "transform": "typia/lib/transform" },
      { "transform": "@ttsc/paths" }
    ],
    "paths": {
