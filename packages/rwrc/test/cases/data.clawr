data MyData {
    field: integer
}

const c: MyData = { field: 1 }
ref r: MyData = copy(of: c)

@main {
    mut m: MyData = c
    m.field = 2 // isolated mutation

    mutref mr: MyData = r
    r->field = 3 // shared mutation

    print(c.field)
    print(m.field)
    print(mr->field)
    print(r->field)
}
